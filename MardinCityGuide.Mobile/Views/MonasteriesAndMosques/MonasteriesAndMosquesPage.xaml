<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MardinCityGuide.Mobile.Views.MonasteriesAndMosques.MonasteriesAndMosquesPage"
             BackgroundColor="#FBF9F6"
             NavigationPage.HasNavigationBar="False"
             ControlTemplate="{StaticResource MainLayoutTemplate}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <!-- Custom Colors -->
            <!--<Color x:Key="PrimaryColor">#725B38</Color>
            <Color x:Key="MardinSand">#C5A880</Color>
            <Color x:Key="TerracottaSunset">#D35400</Color>
            <Color x:Key="MesopotamianBlue">#008080</Color>
            <Color x:Key="OnSurface">#1B1C1A</Color>
            <Color x:Key="OnSurfaceVariant">#4D463C</Color>
            <Color x:Key="SurfaceContainerHigh">#EAE8E5</Color>
            <Color x:Key="SurfaceContainerLowest">#FFFFFF</Color>-->

            <!-- Card Corner Radius -->
            <CornerRadius x:Key="CardCornerRadius">16</CornerRadius>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="*">

        <!-- MAIN SCROLL CONTENT -->
        <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Padding="20,16,20,32" Spacing="24">

                <!-- 2. HERO SECTION -->
                <VerticalStackLayout Spacing="6">
                    <Label Text="MANEVİ MİRAS"
                           FontFamily="BeVietnamProSemiBold"
                           FontSize="12"
                           CharacterSpacing="1.5"
                           TextColor="{StaticResource PrimaryColor}" />

                    <Label Text="Cami &amp; Manastırlar"
                           FontFamily="ManropeBold"
                           FontSize="28"
                           TextColor="{StaticResource OnSurface}" />

                    <Label Text="Medeniyetlerin ve inançların yüzyıllardır dualar fısıldadığı, altın rengi taştan kutsal mekânları keşfedin."
                           FontFamily="BeVietnamProRegular"
                           FontSize="15"
                           LineHeight="1.3"
                           TextColor="{StaticResource OnSurfaceVariant}" />
                </VerticalStackLayout>

                <!-- 3. CATEGORY FILTER CHIPS -->
                <!-- Categories / Chips (Horizontal Scroll) -->
                <CollectionView x:Name="SelectedSiteTypeListCollection" HorizontalScrollBarVisibility="Never" SelectionMode="None">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Horizontal" ItemSpacing="8" />
                    </CollectionView.ItemsLayout>

                    <CollectionView.ItemTemplate>
                        <DataTemplate>

                            <Border StrokeShape="20" Padding="16,0" HeightRequest="36" StrokeThickness="0">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnSiteTypeSelectionChanged" CommandParameter="{Binding Value}" />
                                </Border.GestureRecognizers>

                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroupList>
                                        <VisualStateGroup x:Name="CommonStates">

                                            <!-- normal durum -->
                                            <VisualState x:Name="Normal">
                                                <VisualState.Setters>
                                                    <Setter Property="BackgroundColor" Value="{StaticResource SurfaceContainerHigh}" />
                                                    <Setter TargetName="SiteTypeLabel" Property="Label.TextColor" Value="{StaticResource OnSurfaceVariant}" />
                                                    <Setter TargetName="SiteTypeLabel" Property="Label.FontAttributes" Value="None" />
                                                </VisualState.Setters>
                                            </VisualState>

                                            <!-- seçili durum -->
                                            <VisualState x:Name="Selected">
                                                <VisualState.Setters>
                                                    <Setter Property="BackgroundColor" Value="{StaticResource MardinSand}" />
                                                    <Setter TargetName="SiteTypeLabel" Property="Label.TextColor" Value="White" />
                                                    <Setter TargetName="SiteTypeLabel" Property="Label.FontAttributes" Value="None" />
                                                </VisualState.Setters>
                                            </VisualState>

                                        </VisualStateGroup>
                                    </VisualStateGroupList>
                                </VisualStateManager.VisualStateGroups>

                                <Label x:Name="SiteTypeLabel" Text="{Binding Text}" FontSize="12" VerticalOptions="Center" HorizontalOptions="Center" />
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>


                <!-- 4. CARDS CONTAINER -->

                <CollectionView x:Name="MosquesAndMonasteriesAndMedresesColleciton" VerticalScrollBarVisibility="Never">

                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="24" />
                    </CollectionView.ItemsLayout>

                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <!-- CARD 1: Zinciriye Medresesi -->
                            <Border BackgroundColor="{StaticResource SurfaceContainerLowest}" StrokeShape="RoundRectangle 16" StrokeThickness="0">
                                <Border.Shadow>
                                    <Shadow Brush="#C5A880" Offset="0,4" Radius="12" Opacity="0.15" />
                                </Border.Shadow>

                                <VerticalStackLayout>
                                    <!-- Image Header -->
                                    <Grid HeightRequest="320">
                                        <Image Source="{Binding ImageUrl}" Aspect="AspectFill" />

                                        <!-- Favorite Button -->
                                        <Border HorizontalOptions="End" VerticalOptions="Start" Margin="16" HeightRequest="40" WidthRequest="40" BackgroundColor="#33FFFFFF" StrokeShape="RoundRectangle 20" StrokeThickness="0">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnAddFavoriteTapped" CommandParameter="{Binding ReligiousSiteId}"></TapGestureRecognizer>
                                            </Border.GestureRecognizers>
                                            <Label Text="&#xe87d;" FontFamily="MaterialSymbols" TextColor="{Binding IsFavoriteColor}" FontSize="20" HeightRequest="20" WidthRequest="20" HorizontalOptions="Center" VerticalOptions="Center" />
                                        </Border>

                                        <!-- Badge Category -->
                                        <Border HorizontalOptions="Start"
                    VerticalOptions="End"
                    Margin="16"
                    BackgroundColor="{Binding SiteTypeTextColor}"
                    StrokeShape="RoundRectangle 12"
                    StrokeThickness="0"
                    Padding="12,4">
                                            <Label Text="{Binding SiteType}"
                       FontFamily="BeVietnamProSemiBold"
                       FontSize="10"
                       TextColor="White" />
                                        </Border>
                                    </Grid>

                                    <!-- Card Body -->
                                    <VerticalStackLayout Padding="20" Spacing="12">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Label Grid.Column="0"
                       Text="{Binding Name}"
                       FontFamily="ManropeSemiBold"
                       FontSize="20"
                       TextColor="{StaticResource OnSurface}" />

                                            <HorizontalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                                <Image Source="ic_star.png" HeightRequest="14" WidthRequest="14" />
                                                <Label Text="{Binding Rating}"
                           FontFamily="BeVietnamProSemiBold"
                           FontSize="14"
                           TextColor="{StaticResource TerracottaSunset}" />
                                            </HorizontalStackLayout>
                                        </Grid>

                                        <Label Text="{Binding ShortDescription}"
                   FontFamily="BeVietnamProRegular"
                   FontSize="14"
                   LineBreakMode="TailTruncation"
                   MaxLines="2"
                   TextColor="{StaticResource OnSurfaceVariant}" />

                                        <BoxView HeightRequest="1" Color="#D1C5B8" Margin="0,4" />

                                        <!-- Bottom Info (Hours & Entry) -->
                                        <Grid ColumnDefinitions="*,*">
                                            <HorizontalStackLayout Grid.Column="0" Spacing="8">
                                                <Image Source="ic_schedule.png" HeightRequest="20" WidthRequest="20" VerticalOptions="Center" />
                                                <VerticalStackLayout VerticalOptions="Center">
                                                    <Label Text="Saat" FontSize="10" FontFamily="BeVietnamProSemiBold" TextColor="#7F766A" />
                                                    <Label Text="{Binding OpeningTimeStartAndEimeEnd}" FontSize="13" FontFamily="BeVietnamProSemiBold" TextColor="{StaticResource OnSurface}" />
                                                </VerticalStackLayout>
                                            </HorizontalStackLayout>

                                            <HorizontalStackLayout Grid.Column="1" Spacing="8">
                                                <Image Source="ic_payments.png" HeightRequest="20" WidthRequest="20" VerticalOptions="Center" />
                                                <VerticalStackLayout VerticalOptions="Center">
                                                    <Label Text="Ücret" FontSize="10" FontFamily="BeVietnamProSemiBold" TextColor="#7F766A" />
                                                    <Label Text="{Binding EntryFeeAmount}" FontSize="13" FontFamily="BeVietnamProSemiBold" TextColor="{StaticResource OnSurface}" />
                                                </VerticalStackLayout>
                                            </HorizontalStackLayout>
                                        </Grid>
                                    </VerticalStackLayout>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                </CollectionView>


                <!-- VISITOR ETIQUETTE & CULTURE CARD -->
                <Border StrokeShape="RoundRectangle 16"
        StrokeThickness="0"
        BackgroundColor="#F5F2EC"
        Margin="0,8,0,0">
                    <Border.Shadow>
                        <Shadow Brush="#725B38" Offset="0,4" Radius="10" Opacity="0.1" />
                    </Border.Shadow>

                    <VerticalStackLayout Padding="20" Spacing="16">

                        <!-- 1. Başlık ve Rozet -->
                        <Grid ColumnDefinitions="*,Auto">
                            <HorizontalStackLayout Grid.Column="0" Spacing="8" VerticalOptions="Center">
                                <Label Text="🕊️" FontSize="18" VerticalOptions="Center" />
                                <Label Text="Kutsal Mekan Rehberi"
                       FontFamily="ManropeBold"
                       FontSize="18"
                       TextColor="#725B38"
                       VerticalOptions="Center" />
                            </HorizontalStackLayout>

                            <Border Grid.Column="1"
                    BackgroundColor="#EAE3D2"
                    StrokeShape="RoundRectangle 12"
                    StrokeThickness="0"
                    Padding="10,4">
                                <Label Text="EDEP &amp; KÜLTÜR"
                       FontFamily="BeVietnamProSemiBold"
                       FontSize="9"
                       CharacterSpacing="0.8"
                       TextColor="#725B38" />
                            </Border>
                        </Grid>

                        <!-- Açıklama -->
                        <Label Text="Mardin'deki manastır ve camiler aktif ibadethanelerdir. Ziyaretiniz sırasında dikkat etmeniz gereken temel kurallar:"
               FontFamily="BeVietnamProRegular"
               FontSize="13"
               TextColor="#4D463C"
               LineHeight="1.2" />

                        <!-- 2. Temel Kurallar Listesi (Maddeler) -->
                        <VerticalStackLayout Spacing="10">

                            <!-- Kural 1: Kıyafet -->
                            <Grid ColumnDefinitions="24,*" ColumnSpacing="10">
                                <Label Grid.Column="0" Text="👔" FontSize="14" VerticalOptions="Center" HorizontalOptions="Center" />
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                    <Label Text="Uygun Kıyafet Düzeni"
                           FontFamily="BeVietnamProSemiBold"
                           FontSize="12"
                           TextColor="#1B1C1A" />
                                    <Label Text="Omuz ve dizleri kapatan kıyafetler tercih edilmeli; cami girişlerinde ayakkabılar çıkarılmalıdır."
                           FontFamily="BeVietnamProRegular"
                           FontSize="11"
                           TextColor="#6B6255" />
                                </VerticalStackLayout>
                            </Grid>

                            <BoxView HeightRequest="1" Color="#E5DDD0" />

                            <!-- Kural 2: Sessizlik & Fotoğraf -->
                            <Grid ColumnDefinitions="24,*" ColumnSpacing="10">
                                <Label Grid.Column="0" Text="🔇" FontSize="14" VerticalOptions="Center" HorizontalOptions="Center" />
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                    <Label Text="Sessizlik ve Flaşsız Çekim"
                           FontFamily="BeVietnamProSemiBold"
                           FontSize="12"
                           TextColor="#1B1C1A" />
                                    <Label Text="İç mekânlarda alçak sesle konuşulmalı, ibadet edenler veya din adamları izin almadan çekilmemelidir."
                           FontFamily="BeVietnamProRegular"
                           FontSize="11"
                           TextColor="#6B6255" />
                                </VerticalStackLayout>
                            </Grid>

                            <BoxView HeightRequest="1" Color="#E5DDD0" />

                            <!-- Kural 3: İbadet Saatleri -->
                            <Grid ColumnDefinitions="24,*" ColumnSpacing="10">
                                <Label Grid.Column="0" Text="🕯️" FontSize="14" VerticalOptions="Center" HorizontalOptions="Center" />
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                    <Label Text="İbadet Saatlerine Saygı"
                           FontFamily="BeVietnamProSemiBold"
                           FontSize="12"
                           TextColor="#1B1C1A" />
                                    <Label Text="Manastır pazar ayinleri ve cami namaz vakitlerinde turistik ziyaretler kısıtlanabilir."
                           FontFamily="BeVietnamProRegular"
                           FontSize="11"
                           TextColor="#6B6255" />
                                </VerticalStackLayout>
                            </Grid>

                        </VerticalStackLayout>

                        <!-- 3. Detaylı Rehber Butonu -->
                        <Button Text="Tüm Ziyaret Detaylarını Oku"
                FontFamily="BeVietnamProSemiBold"
                FontSize="13"
                TextColor="White"
                BackgroundColor="#725B38"
                CornerRadius="20"
                HeightRequest="40"
                Margin="0,4,0,0"
                Command="{Binding OpenEtiquetteGuideCommand}"
                                Clicked="OnOpenEtiquetteGuideClicked"/>

                    </VerticalStackLayout>
                </Border>

                <!-- 5. ATMOSPHERIC SHADER / BANNER -->
                <!--<Border HeightRequest="180"
                        StrokeShape="RoundRectangle 16"
                        StrokeThickness="0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#D35400" Offset="0.0" />
                            -->
                <!-- Terracotta Sunset -->
                <!--
                            <GradientStop Color="#725B38" Offset="1.0" />
                            -->
                <!-- Mardin Sand / Earth -->
                <!--
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Shadow>
                        <Shadow Brush="#D35400" Offset="0,6" Radius="12" Opacity="0.25" />
                    </Border.Shadow>

                    <Grid>
                        -->
                <!-- Background Image / Overlay -->
                <!--
                        <Image Source="golden_hour_banner.jpg" Aspect="AspectFill" />
                        <BoxView Color="#80725B38" />

                        <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="8" Padding="20">
                            <Label Text="🌇 Kutsal Mekan Rehberi"
                                   FontFamily="ManropeBold"
                                   FontSize="22"
                                   TextColor="White"
                                   HorizontalTextAlignment="Center" />

                            <Label Text="Bin yıllık duaların yankılandığı manastır ve camilerde kıyafet ve çekim kurallarını keşfedin."
                                   FontFamily="BeVietnamProRegular"
                                   FontSize="13"
                                   TextColor="#E0EEEE"
                                   HorizontalTextAlignment="Center" />

                            <Button Text="Ziyaret Kuralları"
                                    FontFamily="BeVietnamProSemiBold"
                                    FontSize="13"
                                    TextColor="{StaticResource PrimaryColor}"
                                    BackgroundColor="White"
                                    CornerRadius="20"
                                    HeightRequest="40"
                                    Margin="0,8,0,0"
                                    Padding="20,0" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>-->

            </VerticalStackLayout>
        </ScrollView>
        
    </Grid>

</ContentPage>