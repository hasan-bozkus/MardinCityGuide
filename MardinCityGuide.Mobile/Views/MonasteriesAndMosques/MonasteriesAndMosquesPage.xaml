<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MardinCityGuide.Mobile.Views.MonasteriesAndMosques.MonasteriesAndMosquesPage"
             BackgroundColor="#FBF9F6"
             NavigationPage.HasNavigationBar="False">

    <ContentPage.Resources>
        <ResourceDictionary>
            <!-- Custom Colors -->
            <Color x:Key="PrimaryColor">#725B38</Color>
            <Color x:Key="MardinSand">#C5A880</Color>
            <Color x:Key="TerracottaSunset">#D35400</Color>
            <Color x:Key="MesopotamianBlue">#008080</Color>
            <Color x:Key="OnSurface">#1B1C1A</Color>
            <Color x:Key="OnSurfaceVariant">#4D463C</Color>
            <Color x:Key="SurfaceContainerHigh">#EAE8E5</Color>
            <Color x:Key="SurfaceContainerLowest">#FFFFFF</Color>

            <!-- Card Corner Radius -->
            <CornerRadius x:Key="CardCornerRadius">16</CornerRadius>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- 1. TOP APP BAR -->
        <Grid Grid.Row="0" 
              ColumnDefinitions="Auto,*,Auto" 
              HeightRequest="64" 
              Padding="20,0" 
              BackgroundColor="#CCFDFCFB">

            <ImageButton Grid.Column="0"
                         Source="ic_arrow_back.png"
                         HeightRequest="24"
                         WidthRequest="24"
                         BackgroundColor="Transparent"
                         VerticalOptions="Center"
                         Clicked="OnBackButtonClicked" />

            <Label Grid.Column="1"
                   Text="Mardin Guide"
                   FontFamily="ManropeBold"
                   FontSize="20"
                   TextColor="{StaticResource PrimaryColor}"
                   HorizontalOptions="Center"
                   VerticalOptions="Center" />

            <ImageButton Grid.Column="2"
                         Source="ic_search.png"
                         HeightRequest="24"
                         WidthRequest="24"
                         BackgroundColor="Transparent"
                         VerticalOptions="Center"
                         Clicked="OnSearchButtonClicked" />
        </Grid>

        <!-- MAIN SCROLL CONTENT -->
        <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Padding="20,16,20,32" Spacing="24">

                <!-- 2. HERO SECTION -->
                <VerticalStackLayout Spacing="6">
                    <Label Text="SPIRITUAL HERITAGE"
                           FontFamily="BeVietnamProSemiBold"
                           FontSize="12"
                           CharacterSpacing="1.5"
                           TextColor="{StaticResource PrimaryColor}" />

                    <Label Text="Monasteries &amp; Mosques"
                           FontFamily="ManropeBold"
                           FontSize="28"
                           TextColor="{StaticResource OnSurface}" />

                    <Label Text="Explore the golden stone sanctuaries where civilizations and faiths have whispered prayers for centuries."
                           FontFamily="BeVietnamProRegular"
                           FontSize="15"
                           LineHeight="1.3"
                           TextColor="{StaticResource OnSurfaceVariant}" />
                </VerticalStackLayout>

                <!-- 3. CATEGORY FILTER CHIPS -->
                <!-- Categories / Chips (Horizontal Scroll) -->
                <CollectionView x:Name="SelectedSiteTypeListCollection" HorizontalScrollBarVisibility="Never" SelectionMode="None">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Horizontal" ItemSpacing="8" />
                    </CollectionView.ItemsLayout>

                    <CollectionView.ItemTemplate>
                        <DataTemplate>

                            <Border StrokeShape="20" Padding="16,0" HeightRequest="36" StrokeThickness="0">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnSiteTypeSelectionChanged" CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>

                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroupList>
                                        <VisualStateGroup x:Name="CommonStates">

                                            <!-- normal durum -->
                                            <VisualState x:Name="Normal">
                                                <VisualState.Setters>
                                                    <Setter Property="BackgroundColor" Value="{StaticResource SurfaceContainerHigh}" />
                                                    <Setter TargetName="SiteTypeLabel" Property="Label.TextColor" Value="{StaticResource OnSurfaceVariant}" />
                                                    <Setter TargetName="SiteTypeLabel" Property="Label.FontAttributes" Value="None" />
                                                </VisualState.Setters>
                                            </VisualState>

                                            <!-- seçili durum -->
                                            <VisualState x:Name="Selected">
                                                <VisualState.Setters>
                                                    <Setter Property="BackgroundColor" Value="{StaticResource MardinSand}" />
                                                    <Setter TargetName="SiteTypeLabel" Property="Label.TextColor" Value="White" />
                                                    <Setter TargetName="SiteTypeLabel" Property="Label.FontAttributes" Value="None" />
                                                </VisualState.Setters>
                                            </VisualState>

                                        </VisualStateGroup>
                                    </VisualStateGroupList>
                                </VisualStateManager.VisualStateGroups>

                                <Label x:Name="SiteTypeLabel" Text="{Binding Text}" FontSize="12" VerticalOptions="Center" HorizontalOptions="Center" />
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!--<ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never" Margin="-20,0">
                    <HorizontalStackLayout Padding="20,0" Spacing="8">
                        --><!-- Active Chip --><!--
                        <Border BackgroundColor="{StaticResource PrimaryColor}"
                                StrokeShape="RoundRectangle 20"
                                StrokeThickness="0"
                                Padding="20,10">
                            <Label Text="All Sites"
                                   FontFamily="BeVietnamProSemiBold"
                                   FontSize="13"
                                   TextColor="White" />
                        </Border>

                        --><!-- Inactive Chips --><!--
                        <Border BackgroundColor="{StaticResource SurfaceContainerHigh}"
                                StrokeShape="RoundRectangle 20"
                                StrokeThickness="0"
                                Padding="20,10">
                            <Label Text="Monasteries"
                                   FontFamily="BeVietnamProSemiBold"
                                   FontSize="13"
                                   TextColor="{StaticResource OnSurfaceVariant}" />
                        </Border>

                        <Border BackgroundColor="{StaticResource SurfaceContainerHigh}"
                                StrokeShape="RoundRectangle 20"
                                StrokeThickness="0"
                                Padding="20,10">
                            <Label Text="Mosques"
                                   FontFamily="BeVietnamProSemiBold"
                                   FontSize="13"
                                   TextColor="{StaticResource OnSurfaceVariant}" />
                        </Border>

                        <Border BackgroundColor="{StaticResource SurfaceContainerHigh}"
                                StrokeShape="RoundRectangle 20"
                                StrokeThickness="0"
                                Padding="20,10">
                            <Label Text="Medreses"
                                   FontFamily="BeVietnamProSemiBold"
                                   FontSize="13"
                                   TextColor="{StaticResource OnSurfaceVariant}" />
                        </Border>
                    </HorizontalStackLayout>
                </ScrollView>-->

                <!-- 4. CARDS CONTAINER -->

                <CollectionView x:Name="MosquesAndMonasteriesAndMedresesColleciton" VerticalScrollBarVisibility="Never">

                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Vertical" ItemSpacing="24" />
                        </CollectionView.ItemsLayout>

                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <!-- CARD 1: Zinciriye Medresesi -->
                            <Border BackgroundColor="{StaticResource SurfaceContainerLowest}" StrokeShape="RoundRectangle 16" StrokeThickness="0">
                                <Border.Shadow>
                                    <Shadow Brush="#C5A880" Offset="0,4" Radius="12" Opacity="0.15" />
                                </Border.Shadow>

                                <VerticalStackLayout>
                                    <!-- Image Header -->
                                    <Grid HeightRequest="320">
                                        <Image Source="{Binding ImageUrl}" Aspect="AspectFill" />

                                        <!-- Favorite Button -->
                                        <Border HorizontalOptions="End"
                    VerticalOptions="Start"
                    Margin="16"
                    HeightRequest="40"
                    WidthRequest="40"
                    BackgroundColor="#33FFFFFF"
                    StrokeShape="RoundRectangle 20"
                    StrokeThickness="0">
                                            <Image Source="ic_favorite_border.png"
                       HeightRequest="20"
                       WidthRequest="20"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
                                        </Border>

                                        <!-- Badge Category -->
                                        <Border HorizontalOptions="Start"
                    VerticalOptions="End"
                    Margin="16"
                    BackgroundColor="{Binding SiteTypeTextColor}"
                    StrokeShape="RoundRectangle 12"
                    StrokeThickness="0"
                    Padding="12,4">
                                            <Label Text="{Binding SiteType}"
                       FontFamily="BeVietnamProSemiBold"
                       FontSize="10"
                       TextColor="White" />
                                        </Border>
                                    </Grid>

                                    <!-- Card Body -->
                                    <VerticalStackLayout Padding="20" Spacing="12">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Label Grid.Column="0"
                       Text="{Binding Name}"
                       FontFamily="ManropeSemiBold"
                       FontSize="20"
                       TextColor="{StaticResource OnSurface}" />

                                            <HorizontalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                                <Image Source="ic_star.png" HeightRequest="14" WidthRequest="14" />
                                                <Label Text="{Binding Rating}"
                           FontFamily="BeVietnamProSemiBold"
                           FontSize="14"
                           TextColor="{StaticResource TerracottaSunset}" />
                                            </HorizontalStackLayout>
                                        </Grid>

                                        <Label Text="{Binding ShortDescription}"
                   FontFamily="BeVietnamProRegular"
                   FontSize="14"
                   LineBreakMode="TailTruncation"
                   MaxLines="2"
                   TextColor="{StaticResource OnSurfaceVariant}" />

                                        <BoxView HeightRequest="1" Color="#D1C5B8" Margin="0,4" />

                                        <!-- Bottom Info (Hours & Entry) -->
                                        <Grid ColumnDefinitions="*,*">
                                            <HorizontalStackLayout Grid.Column="0" Spacing="8">
                                                <Image Source="ic_schedule.png" HeightRequest="20" WidthRequest="20" VerticalOptions="Center" />
                                                <VerticalStackLayout VerticalOptions="Center">
                                                    <Label Text="Saat" FontSize="10" FontFamily="BeVietnamProSemiBold" TextColor="#7F766A" />
                                                    <Label Text="{Binding OpeningTimeStartAndEimeEnd}" FontSize="13" FontFamily="BeVietnamProSemiBold" TextColor="{StaticResource OnSurface}" />
                                                </VerticalStackLayout>
                                            </HorizontalStackLayout>

                                            <HorizontalStackLayout Grid.Column="1" Spacing="8">
                                                <Image Source="ic_payments.png" HeightRequest="20" WidthRequest="20" VerticalOptions="Center" />
                                                <VerticalStackLayout VerticalOptions="Center">
                                                    <Label Text="Ücret" FontSize="10" FontFamily="BeVietnamProSemiBold" TextColor="#7F766A" />
                                                    <Label Text="{Binding EntryFeeAmount}" FontSize="13" FontFamily="BeVietnamProSemiBold" TextColor="{StaticResource OnSurface}" />
                                                </VerticalStackLayout>
                                            </HorizontalStackLayout>
                                        </Grid>
                                    </VerticalStackLayout>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                    
                </CollectionView>
                

                <!-- 5. ATMOSPHERIC SHADER / BANNER -->
                <Border HeightRequest="180"
                        StrokeShape="RoundRectangle 16"
                        StrokeThickness="0">
                    <Grid>
                        <!-- Background Image / Overlay -->
                        <Image Source="golden_hour_banner.jpg" Aspect="AspectFill" />
                        <BoxView Color="#80725B38" />

                        <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="8" Padding="20">
                            <Label Text="The Golden Hour Tour"
                                   FontFamily="ManropeBold"
                                   FontSize="22"
                                   TextColor="White"
                                   HorizontalTextAlignment="Center" />

                            <Label Text="Experience these sites under the magic of Mesopotamian light."
                                   FontFamily="BeVietnamProRegular"
                                   FontSize="13"
                                   TextColor="#E0EEEE"
                                   HorizontalTextAlignment="Center" />

                            <Button Text="Book Private Concierge"
                                    FontFamily="BeVietnamProSemiBold"
                                    FontSize="13"
                                    TextColor="{StaticResource PrimaryColor}"
                                    BackgroundColor="White"
                                    CornerRadius="20"
                                    HeightRequest="40"
                                    Margin="0,8,0,0"
                                    Padding="20,0" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <!-- 6. BOTTOM NAVIGATION BAR -->
        <Border Grid.Row="2"
                BackgroundColor="#EFFDFCFB"
                StrokeShape="RoundRectangle 16,16,0,0"
                StrokeThickness="0"
                HeightRequest="64"
                Padding="8,0">
            <Border.Shadow>
                <Shadow Brush="#C5A880" Offset="0,-4" Radius="12" Opacity="0.15" />
            </Border.Shadow>

            <Grid ColumnDefinitions="*,*,*,*">
                <!-- Home Tab -->
                <VerticalStackLayout Grid.Column="0" VerticalOptions="Center" HorizontalOptions="Center" Spacing="2">
                    <Image Source="ic_home.png" HeightRequest="22" WidthRequest="22" />
                    <Label Text="Home" FontSize="11" FontFamily="BeVietnamProSemiBold" TextColor="{StaticResource OnSurfaceVariant}" />
                </VerticalStackLayout>

                <!-- Active Discover Tab -->
                <Border Grid.Column="1"
                        BackgroundColor="#4DFEDEB2"
                        StrokeShape="RoundRectangle 18"
                        StrokeThickness="0"
                        Padding="16,6"
                        HorizontalOptions="Center"
                        VerticalOptions="Center">
                    <VerticalStackLayout Spacing="2">
                        <Image Source="ic_explore_active.png" HeightRequest="22" WidthRequest="22" />
                        <Label Text="Discover" FontSize="11" FontFamily="BeVietnamProSemiBold" TextColor="{StaticResource PrimaryColor}" />
                    </VerticalStackLayout>
                </Border>

                <!-- Favorites Tab -->
                <VerticalStackLayout Grid.Column="2" VerticalOptions="Center" HorizontalOptions="Center" Spacing="2">
                    <Image Source="ic_favorite.png" HeightRequest="22" WidthRequest="22" />
                    <Label Text="Favorites" FontSize="11" FontFamily="BeVietnamProSemiBold" TextColor="{StaticResource OnSurfaceVariant}" />
                </VerticalStackLayout>

                <!-- Profile Tab -->
                <VerticalStackLayout Grid.Column="3" VerticalOptions="Center" HorizontalOptions="Center" Spacing="2">
                    <Image Source="ic_profile.png" HeightRequest="22" WidthRequest="22" />
                    <Label Text="Profile" FontSize="11" FontFamily="BeVietnamProSemiBold" TextColor="{StaticResource OnSurfaceVariant}" />
                </VerticalStackLayout>
            </Grid>
        </Border>

    </Grid>

</ContentPage>