<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MardinCityGuide.Mobile.Views.GastronomyGuide.GastronomyGuidePage"
             BackgroundColor="#FDFCFB"
             Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <ResourceDictionary>
            <!-- Design Colors -->
            <Color x:Key="SurfaceIvory">#FDFCFB</Color>
            <Color x:Key="PrimaryText">#1B1C1A</Color>
            <Color x:Key="SecondaryText">#4D463C</Color>
            <Color x:Key="MardinSand">#C5A880</Color>
            <Color x:Key="PrimaryBrand">#725B38</Color>
            <Color x:Key="TerracottaSunset">#D35400</Color>
            <Color x:Key="OnSurfaceVariant">#4D463C</Color>
            <Color x:Key="SurfaceContainerLow">#F5F3F0</Color>
            <Color x:Key="SurfaceContainerLowest">#FFFFFF</Color>
            <Color x:Key="PrimaryFixedVariant">#584323</Color>
            <Color x:Key="SurfaceContainerHigh">#EAE8E5</Color>
            <Color x:Key="PrimaryFixed">#FEDEB2</Color>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Top Navigation Bar -->
        <Grid Grid.Row="0" 
              HeightRequest="64" 
              Padding="20,0" 
              ColumnDefinitions="Auto,*,Auto" 
              BackgroundColor="#CCFDFCFB">

            <ImageButton Grid.Column="0"
                         Source="ic_arrow_back.png"
                         HeightRequest="24"
                         WidthRequest="24"
                         BackgroundColor="Transparent"
                         VerticalOptions="Center" />

            <Label Grid.Column="1"
                   Text="Mardin Guide"
                   TextColor="{StaticResource PrimaryBrand}"
                   FontSize="22"
                   FontAttributes="Bold"
                   FontFamily="Manrope"
                   VerticalOptions="Center"
                   Margin="16,0,0,0" />

            <ImageButton Grid.Column="2"
                         Source="ic_search.png"
                         HeightRequest="24"
                         WidthRequest="24"
                         BackgroundColor="Transparent"
                         VerticalOptions="Center" />
        </Grid>

        <!-- Main Content Area -->
        <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Padding="0,16,0,32" Spacing="24">

                <!-- Hero Header Section -->
                <VerticalStackLayout Padding="20,0" Spacing="4">
                    <Label Text="Taste of Mesopotamia"
                           FontSize="28"
                           FontAttributes="Bold"
                           FontFamily="Manrope"
                           TextColor="{StaticResource PrimaryText}" />
                    <Label Text="Experience the thousand-year culinary heritage of the golden city."
                           FontSize="16"
                           FontFamily="BeVietnamPro"
                           TextColor="{StaticResource SecondaryText}" />
                </VerticalStackLayout>

                <!-- Filter Chips (Horizontal Scroll) -->

                <CollectionView x:Name="SelectedTypeLabelCollection" HorizontalScrollBarVisibility="Never" SelectionMode="None">

                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Horizontal" ItemSpacing="8" />
                    </CollectionView.ItemsLayout>

                    <CollectionView.ItemTemplate>
                        <DataTemplate>

                            <Border StrokeShape="20" Padding="16,0" HeightRequest="36" StrokeThickness="0">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnTypeLabelSelectionChanged" CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>

                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroupList>
                                        <VisualStateGroup x:Name="CommonStates">

                                            <!-- normal durum -->
                                            <VisualState x:Name="Normal">
                                                <VisualState.Setters>
                                                    <Setter Property="BackgroundColor" Value="{StaticResource SurfaceContainerHigh}" />
                                                    <Setter TargetName="CategoryLabel" Property="Label.TextColor" Value="{StaticResource OnSurfaceVariant}" />
                                                    <Setter TargetName="CategoryLabel" Property="Label.FontAttributes" Value="None" />
                                                </VisualState.Setters>
                                            </VisualState>

                                            <!-- seçili durum -->
                                            <VisualState x:Name="Selected">
                                                <VisualState.Setters>
                                                    <Setter Property="BackgroundColor" Value="{StaticResource MardinSand}" />
                                                    <Setter TargetName="CategoryLabel" Property="Label.TextColor" Value="White" />
                                                    <Setter TargetName="CategoryLabel" Property="Label.FontAttributes" Value="None" />
                                                </VisualState.Setters>
                                            </VisualState>

                                        </VisualStateGroup>
                                    </VisualStateGroupList>
                                </VisualStateManager.VisualStateGroups>

                                <Label x:Name="CategoryLabel" Text="{Binding CategoryName}" FontSize="12" VerticalOptions="Center" HorizontalOptions="Center" />
                            </Border>

                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
                
                <!--<ScrollView HorizontalScrollBarVisibility="Never" Orientation="Horizontal">
                    <HorizontalStackLayout Padding="20,0" Spacing="8">
                                             
                        --><!-- Active Chip: All Places --><!--
                        <Border StrokeShape="RoundRectangle 20"
                                BackgroundColor="{StaticResource PrimaryBrand}"
                                Stroke="{StaticResource MardinSand}"
                                StrokeThickness="1"
                                Padding="24,8">
                            <Label Text="All Places"
                                   TextColor="#FFFFFF"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   FontFamily="BeVietnamPro" />
                        </Border>

                        --><!-- Chip: Traditional --><!--
                        <Border StrokeShape="RoundRectangle 20"
                                BackgroundColor="{StaticResource SurfaceContainerLow}"
                                Stroke="{StaticResource MardinSand}"
                                StrokeThickness="1"
                                Padding="24,8">
                            <Label Text="Traditional"
                                   TextColor="{StaticResource SecondaryText}"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   FontFamily="BeVietnamPro" />
                        </Border>

                        --><!-- Chip: Terraced Cafes --><!--
                        <Border StrokeShape="RoundRectangle 20"
                                BackgroundColor="{StaticResource SurfaceContainerLow}"
                                Stroke="{StaticResource MardinSand}"
                                StrokeThickness="1"
                                Padding="24,8">
                            <Label Text="Terraced Cafes"
                                   TextColor="{StaticResource SecondaryText}"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   FontFamily="BeVietnamPro" />
                        </Border>

                        --><!-- Chip: Local Wineries --><!--
                        <Border StrokeShape="RoundRectangle 20"
                                BackgroundColor="{StaticResource SurfaceContainerLow}"
                                Stroke="{StaticResource MardinSand}"
                                StrokeThickness="1"
                                Padding="24,8">
                            <Label Text="Local Wineries"
                                   TextColor="{StaticResource SecondaryText}"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   FontFamily="BeVietnamPro" />
                        </Border>

                    </HorizontalStackLayout>
                </ScrollView>-->

                <!-- Featured Gastronomy Card -->
                <BoxView HeightRequest="1" Color="Transparent" Margin="0,-8,0,0"/>
                <VerticalStackLayout Padding="20,0">
                    <Border StrokeShape="RoundRectangle 24"
                            BackgroundColor="{StaticResource SurfaceContainerLowest}"
                            Stroke="Transparent"
                            Margin="0,0,0,16">
                        <Border.Shadow>
                            <Shadow Brush="#C5A880" Offset="0,4" Radius="12" Opacity="0.15" />
                        </Border.Shadow>

                        <VerticalStackLayout x:Name="GetHighsetStarredPlaceColleciton">
                            <!-- Main Image Container -->
                            <Grid HeightRequest="380">
                                <Image Source="{Binding CoverImageUrl}"
                                       Aspect="AspectFill" />

                                <!-- Rating Badge -->
                                <Border HorizontalOptions="End"
                                        VerticalOptions="Start"
                                        Margin="16"
                                        Padding="12,4"
                                        StrokeShape="RoundRectangle 16"
                                        BackgroundColor="#CCFDFCFB"
                                        Stroke="Transparent">
                                    <HorizontalStackLayout Spacing="4">
                                        <Image Source="ic_star_filled.png" WidthRequest="18" HeightRequest="18" />
                                        <Label Text="{Binding Rating}"
                                               FontSize="12"
                                               FontAttributes="Bold"
                                               TextColor="{StaticResource PrimaryText}"
                                               VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </Border>
                            </Grid>

                            <!-- Content Details -->
                            <VerticalStackLayout Padding="20" Spacing="12">
                                <Grid ColumnDefinitions="*,Auto">
                                    <VerticalStackLayout Grid.Column="0">
                                        <Label Text="{Binding Name}"
                                               FontSize="20"
                                               FontAttributes="Bold"
                                               FontFamily="Manrope"
                                               TextColor="{StaticResource PrimaryText}" />
                                        <Label Text="{Binding Description}"
                                               FontSize="14"
                                               FontFamily="BeVietnamPro"
                                               TextColor="{StaticResource SecondaryText}" />
                                    </VerticalStackLayout>

                                    <Label Grid.Column="1"
                                           x:Name="PriceLevelText"
                                           FontSize="20"
                                           FontAttributes="Bold"
                                           FontFamily="Manrope"
                                           TextColor="{StaticResource PrimaryBrand}"
                                           VerticalOptions="Start" />
                                </Grid>

                                <!-- Location -->
                                <HorizontalStackLayout Spacing="6">
                                    <Image Source="ic_location_on.png" WidthRequest="18" HeightRequest="18" />
                                    <Label Text="{Binding Location.AddressText}"
                                           FontSize="12"
                                           FontFamily="BeVietnamPro"
                                           TextColor="{StaticResource SecondaryText}"
                                           VerticalOptions="Center" />
                                </HorizontalStackLayout>

                                <!-- View Menu Button -->
                                <Button Text="Menüyü Görüntüle"
                                        BackgroundColor="{StaticResource MardinSand}"
                                        TextColor="{StaticResource SurfaceContainerLowest}"
                                        FontFamily="Manrope"
                                        FontSize="18"
                                        FontAttributes="Bold"
                                        CornerRadius="12"
                                        HeightRequest="48"
                                        Margin="0,8,0,0" />
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- Secondary List (Local Favorites Grid) -->
                <VerticalStackLayout Padding="20,0" Spacing="24">
                    <Label Text="Yerel Mekanlar" FontSize="24" FontAttributes="Bold" FontFamily="Manrope" TextColor="{StaticResource PrimaryText}" />
                    <CollectionView VerticalScrollBarVisibility="Never" x:Name="PlaceCollection">

                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Vertical" ItemSpacing="24" />
                        </CollectionView.ItemsLayout>

                        <CollectionView.ItemTemplate>
                            <DataTemplate>

                                <!-- Card 2: Seyri Merdin -->
                                <VerticalStackLayout Spacing="12">
                                    <Grid HeightRequest="320">
                                        <Border StrokeShape="RoundRectangle 16" Stroke="Transparent">
                                            <Image Source="{Binding CoverImageUrl}" Aspect="AspectFill" />
                                        </Border>

                                        <Border HorizontalOptions="End" VerticalOptions="Start" Margin="12" Padding="10,2" StrokeShape="RoundRectangle 12" BackgroundColor="#E6FFFFFF" Stroke="Transparent">
                                            <Label Text="{Binding PriceLevel}" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource PrimaryText}" />
                                        </Border>
                                    </Grid>

                                    <Grid ColumnDefinitions="*,Auto">
                                        <VerticalStackLayout Grid.Column="0">
                                            <Label Text="{Binding Name}" FontSize="20" FontAttributes="Bold" FontFamily="Manrope" TextColor="{StaticResource PrimaryText}" />
                                            <HorizontalStackLayout Spacing="4">
                                                <Image Source="ic_location_on.png" WidthRequest="16" HeightRequest="16" />
                                                <Label Text="{Binding Location.LocationName}" FontSize="12" TextColor="{StaticResource SecondaryText}" />
                                            </HorizontalStackLayout>
                                        </VerticalStackLayout>

                                        <HorizontalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                            <Image Source="ic_star_filled.png" WidthRequest="18" HeightRequest="18" />
                                            <Label Text="{Binding Rating}" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource PrimaryText}" />
                                        </HorizontalStackLayout>
                                    </Grid>
                                </VerticalStackLayout>

                            </DataTemplate>
                        </CollectionView.ItemTemplate>

                    </CollectionView>
                </VerticalStackLayout>
                
            </VerticalStackLayout>
        </ScrollView>

        <!-- Bottom Navigation Bar -->
        <Border Grid.Row="2"
                StrokeShape="RoundRectangle 16,16,0,0"
                BackgroundColor="#E6FDFCFB"
                Stroke="Transparent"
                Padding="16,8">
            <Border.Shadow>
                <Shadow Brush="#C5A880" Offset="0,-4" Radius="12" Opacity="0.15" />
            </Border.Shadow>

            <Grid ColumnDefinitions="*,*,*,*">
                <!-- Home -->
                <VerticalStackLayout Grid.Column="0" HorizontalOptions="Center" Spacing="2">
                    <Image Source="ic_home.png" WidthRequest="24" HeightRequest="24" />
                    <Label Text="Home" FontSize="12" TextColor="{StaticResource SecondaryText}" HorizontalOptions="Center" />
                </VerticalStackLayout>

                <!-- Discover (Active State) -->
                <Border Grid.Column="1"
                        BackgroundColor="#4D93F2F2"
                        StrokeShape="RoundRectangle 20"
                        Padding="16,4"
                        HorizontalOptions="Center">
                    <VerticalStackLayout Spacing="2">
                        <Image Source="ic_explore_filled.png" WidthRequest="24" HeightRequest="24" />
                        <Label Text="Discover" FontSize="12" TextColor="{StaticResource PrimaryBrand}" FontAttributes="Bold" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>

                <!-- Favorites -->
                <VerticalStackLayout Grid.Column="2" HorizontalOptions="Center" Spacing="2">
                    <Image Source="ic_favorite.png" WidthRequest="24" HeightRequest="24" />
                    <Label Text="Favorites" FontSize="12" TextColor="{StaticResource SecondaryText}" HorizontalOptions="Center" />
                </VerticalStackLayout>

                <!-- Profile -->
                <VerticalStackLayout Grid.Column="3" HorizontalOptions="Center" Spacing="2">
                    <Image Source="ic_person.png" WidthRequest="24" HeightRequest="24" />
                    <Label Text="Profile" FontSize="12" TextColor="{StaticResource SecondaryText}" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Grid>
        </Border>

    </Grid>

</ContentPage>