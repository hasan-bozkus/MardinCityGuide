<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MardinCityGuide.Mobile.Views.GastronomyGuide.GastronomyGuidePage"
             BackgroundColor="#FDFCFB"
             Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <ResourceDictionary>
            <!-- Design Colors -->
            <Color x:Key="SurfaceIvory">#FDFCFB</Color>
            <Color x:Key="PrimaryText">#1B1C1A</Color>
            <Color x:Key="SecondaryText">#4D463C</Color>
            <Color x:Key="MardinSand">#C5A880</Color>
            <Color x:Key="PrimaryBrand">#725B38</Color>
            <Color x:Key="TerracottaSunset">#D35400</Color>
            <Color x:Key="SurfaceContainerLow">#F5F3F0</Color>
            <Color x:Key="SurfaceContainerLowest">#FFFFFF</Color>
            <Color x:Key="PrimaryFixedVariant">#584323</Color>
            <Color x:Key="PrimaryFixed">#FEDEB2</Color>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Top Navigation Bar -->
        <Grid Grid.Row="0" 
              HeightRequest="64" 
              Padding="20,0" 
              ColumnDefinitions="Auto,*,Auto" 
              BackgroundColor="#CCFDFCFB">

            <ImageButton Grid.Column="0"
                         Source="ic_arrow_back.png"
                         HeightRequest="24"
                         WidthRequest="24"
                         BackgroundColor="Transparent"
                         VerticalOptions="Center" />

            <Label Grid.Column="1"
                   Text="Mardin Guide"
                   TextColor="{StaticResource PrimaryBrand}"
                   FontSize="22"
                   FontAttributes="Bold"
                   FontFamily="Manrope"
                   VerticalOptions="Center"
                   Margin="16,0,0,0" />

            <ImageButton Grid.Column="2"
                         Source="ic_search.png"
                         HeightRequest="24"
                         WidthRequest="24"
                         BackgroundColor="Transparent"
                         VerticalOptions="Center" />
        </Grid>

        <!-- Main Content Area -->
        <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Padding="0,16,0,32" Spacing="24">

                <!-- Hero Header Section -->
                <VerticalStackLayout Padding="20,0" Spacing="4">
                    <Label Text="Taste of Mesopotamia"
                           FontSize="28"
                           FontAttributes="Bold"
                           FontFamily="Manrope"
                           TextColor="{StaticResource PrimaryText}" />
                    <Label Text="Experience the thousand-year culinary heritage of the golden city."
                           FontSize="16"
                           FontFamily="BeVietnamPro"
                           TextColor="{StaticResource SecondaryText}" />
                </VerticalStackLayout>

                <!-- Filter Chips (Horizontal Scroll) -->
                <ScrollView HorizontalScrollBarVisibility="Never" Orientation="Horizontal">
                    <HorizontalStackLayout Padding="20,0" Spacing="8">

                        <!-- Active Chip: All Places -->
                        <Border StrokeShape="RoundRectangle 20"
                                BackgroundColor="{StaticResource PrimaryBrand}"
                                Stroke="{StaticResource MardinSand}"
                                StrokeThickness="1"
                                Padding="24,8">
                            <Label Text="All Places"
                                   TextColor="#FFFFFF"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   FontFamily="BeVietnamPro" />
                        </Border>

                        <!-- Chip: Traditional -->
                        <Border StrokeShape="RoundRectangle 20"
                                BackgroundColor="{StaticResource SurfaceContainerLow}"
                                Stroke="{StaticResource MardinSand}"
                                StrokeThickness="1"
                                Padding="24,8">
                            <Label Text="Traditional"
                                   TextColor="{StaticResource SecondaryText}"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   FontFamily="BeVietnamPro" />
                        </Border>

                        <!-- Chip: Terraced Cafes -->
                        <Border StrokeShape="RoundRectangle 20"
                                BackgroundColor="{StaticResource SurfaceContainerLow}"
                                Stroke="{StaticResource MardinSand}"
                                StrokeThickness="1"
                                Padding="24,8">
                            <Label Text="Terraced Cafes"
                                   TextColor="{StaticResource SecondaryText}"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   FontFamily="BeVietnamPro" />
                        </Border>

                        <!-- Chip: Local Wineries -->
                        <Border StrokeShape="RoundRectangle 20"
                                BackgroundColor="{StaticResource SurfaceContainerLow}"
                                Stroke="{StaticResource MardinSand}"
                                StrokeThickness="1"
                                Padding="24,8">
                            <Label Text="Local Wineries"
                                   TextColor="{StaticResource SecondaryText}"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   FontFamily="BeVietnamPro" />
                        </Border>

                    </HorizontalStackLayout>
                </ScrollView>

                <!-- Featured Gastronomy Card -->
                <BoxView HeightRequest="1" Color="Transparent" Margin="0,-8,0,0"/>
                <VerticalStackLayout Padding="20,0">
                    <Border StrokeShape="RoundRectangle 24"
                            BackgroundColor="{StaticResource SurfaceContainerLowest}"
                            Stroke="Transparent"
                            Margin="0,0,0,16">
                        <Border.Shadow>
                            <Shadow Brush="#C5A880" Offset="0,4" Radius="12" Opacity="0.15" />
                        </Border.Shadow>

                        <VerticalStackLayout>
                            <!-- Main Image Container -->
                            <Grid HeightRequest="380">
                                <Image Source="https://lh3.googleusercontent.com/aida-public/AB6AXuAeZzv8ubJmN8DtKe9Tzx2WH2TDmy2O5p6b4S9wq0o8XQ8szyoH4-W-aOobBNmVU74CgjlFZ42Vu3AVHoAm2lm-jRorkfLrdMCDffooUzRlS8yuL1t4sOSx9VaVzeH1jHg0ux8qCATEV4nZD2Vl16olcmfZBD6Symdn-vLjN_C2WNxJjAdqAP2JbLlM-vom-JvU6Km3xvV596OA-CHX8ZgzTPg26VcaLOUtovPOSb86gmh7CQHw8KynlA"
                                       Aspect="AspectFill" />

                                <!-- Rating Badge -->
                                <Border HorizontalOptions="End"
                                        VerticalOptions="Start"
                                        Margin="16"
                                        Padding="12,4"
                                        StrokeShape="RoundRectangle 16"
                                        BackgroundColor="#CCFDFCFB"
                                        Stroke="Transparent">
                                    <HorizontalStackLayout Spacing="4">
                                        <Image Source="ic_star_filled.png" WidthRequest="18" HeightRequest="18" />
                                        <Label Text="4.9"
                                               FontSize="12"
                                               FontAttributes="Bold"
                                               TextColor="{StaticResource PrimaryText}"
                                               VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </Border>
                            </Grid>

                            <!-- Content Details -->
                            <VerticalStackLayout Padding="20" Spacing="12">
                                <Grid ColumnDefinitions="*,Auto">
                                    <VerticalStackLayout Grid.Column="0">
                                        <Label Text="Cercis Murat Konağı"
                                               FontSize="20"
                                               FontAttributes="Bold"
                                               FontFamily="Manrope"
                                               TextColor="{StaticResource PrimaryText}" />
                                        <Label Text="Traditional Mardin Cuisine"
                                               FontSize="14"
                                               FontFamily="BeVietnamPro"
                                               TextColor="{StaticResource SecondaryText}" />
                                    </VerticalStackLayout>

                                    <Label Grid.Column="1"
                                           Text="$$$"
                                           FontSize="20"
                                           FontAttributes="Bold"
                                           FontFamily="Manrope"
                                           TextColor="{StaticResource PrimaryBrand}"
                                           VerticalOptions="Start" />
                                </Grid>

                                <!-- Location -->
                                <HorizontalStackLayout Spacing="6">
                                    <Image Source="ic_location_on.png" WidthRequest="18" HeightRequest="18" />
                                    <Label Text="Eski Mardin, Artuklu"
                                           FontSize="12"
                                           FontFamily="BeVietnamPro"
                                           TextColor="{StaticResource SecondaryText}"
                                           VerticalOptions="Center" />
                                </HorizontalStackLayout>

                                <!-- View Menu Button -->
                                <Button Text="View Tasting Menu"
                                        BackgroundColor="{StaticResource MardinSand}"
                                        TextColor="{StaticResource SurfaceContainerLowest}"
                                        FontFamily="Manrope"
                                        FontSize="18"
                                        FontAttributes="Bold"
                                        CornerRadius="12"
                                        HeightRequest="48"
                                        Margin="0,8,0,0" />
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- Secondary List (Local Favorites Grid) -->
                <VerticalStackLayout Padding="20,0" Spacing="24">
                    <Label Text="Local Favorites"
                           FontSize="24"
                           FontAttributes="Bold"
                           FontFamily="Manrope"
                           TextColor="{StaticResource PrimaryText}" />

                    <!-- Card 2: Seyri Merdin -->
                    <VerticalStackLayout Spacing="12">
                        <Grid HeightRequest="320">
                            <Border StrokeShape="RoundRectangle 16" Stroke="Transparent">
                                <Image Source="https://lh3.googleusercontent.com/aida-public/AB6AXuC_2TNo6TSQ9rTb7Woiw7S7tZrhCWwW4BwVQuIpqjs6PilALysxU98lNYGrGSmnu0ILbLXZQFo7COJ0iCDunh89ZyP1XF4RTUb5ZIKBtCpkkQSt3RaBWID3knebiZR6ovlOS7DgOza7y3O6Hv8aiCx8_h5JHUbVKNd6vpj_0MJOutQdS1FR1WE8oB0iG9TqB9Z8yKqhaTW4lsfo4FfXoT1xxZi2WX9tFBFEb8i-X9bFQvePGKTqnk7Osw"
                                       Aspect="AspectFill" />
                            </Border>

                            <Border HorizontalOptions="End"
                                    VerticalOptions="Start"
                                    Margin="12"
                                    Padding="10,2"
                                    StrokeShape="RoundRectangle 12"
                                    BackgroundColor="#E6FFFFFF"
                                    Stroke="Transparent">
                                <Label Text="$$"
                                       FontSize="12"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource PrimaryText}" />
                            </Border>
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Grid.Column="0">
                                <Label Text="Seyri Merdin"
                                       FontSize="20"
                                       FontAttributes="Bold"
                                       FontFamily="Manrope"
                                       TextColor="{StaticResource PrimaryText}" />
                                <HorizontalStackLayout Spacing="4">
                                    <Image Source="ic_location_on.png" WidthRequest="16" HeightRequest="16" />
                                    <Label Text="Terraced Cafe • 0.2 km"
                                           FontSize="12"
                                           TextColor="{StaticResource SecondaryText}" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>

                            <HorizontalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                <Image Source="ic_star_filled.png" WidthRequest="18" HeightRequest="18" />
                                <Label Text="4.7"
                                       FontSize="12"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource PrimaryText}" />
                            </HorizontalStackLayout>
                        </Grid>
                    </VerticalStackLayout>

                    <!-- Card 3: Shiluh Winery -->
                    <VerticalStackLayout Spacing="12">
                        <Grid HeightRequest="320">
                            <Border StrokeShape="RoundRectangle 16" Stroke="Transparent">
                                <Image Source="https://lh3.googleusercontent.com/aida-public/AB6AXuCM0pV-em5pBYgVgXjAkp2CLNH0ezZY3py5sC-ahmMbEoUWTte2NEm5l-n4by4crAwncHk2UNrtzocQWcq4Rp5iLisFYFE1fpHvJ7ewpMe6A7RjAE-NnAGJGxoBJPcrT_AxPzMg2rTYyBaxQL4r5I8HbyD1FXnxuXjatZk-oMPrYzdTa3GcjAr4qMVdmFNV-PW8EVWqbPPScG13WfA34wOZqclrZxx8X2nmJAiEfoTEG66vS8XVYt_HOg"
                                       Aspect="AspectFill" />
                            </Border>

                            <Border HorizontalOptions="End"
                                    VerticalOptions="Start"
                                    Margin="12"
                                    Padding="10,2"
                                    StrokeShape="RoundRectangle 12"
                                    BackgroundColor="#E6FFFFFF"
                                    Stroke="Transparent">
                                <Label Text="$$$"
                                       FontSize="12"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource PrimaryText}" />
                            </Border>
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Grid.Column="0">
                                <Label Text="Shiluh Winery"
                                       FontSize="20"
                                       FontAttributes="Bold"
                                       FontFamily="Manrope"
                                       TextColor="{StaticResource PrimaryText}" />
                                <HorizontalStackLayout Spacing="4">
                                    <Image Source="ic_location_on.png" WidthRequest="16" HeightRequest="16" />
                                    <Label Text="Local Winery • 1.5 km"
                                           FontSize="12"
                                           TextColor="{StaticResource SecondaryText}" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>

                            <HorizontalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                <Image Source="ic_star_filled.png" WidthRequest="18" HeightRequest="18" />
                                <Label Text="4.8"
                                       FontSize="12"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource PrimaryText}" />
                            </HorizontalStackLayout>
                        </Grid>
                    </VerticalStackLayout>

                    <!-- Card 4: Leyli Muse Mutfak -->
                    <VerticalStackLayout Spacing="12">
                        <Grid HeightRequest="320">
                            <Border StrokeShape="RoundRectangle 16" Stroke="Transparent">
                                <Image Source="https://lh3.googleusercontent.com/aida-public/AB6AXuB37W2M4OdoPP_cnYX8OhzJQLeMXwK21FpTDv8ChFcE4GXYoX7Ti5lrr-gnwMTICKfBNTfkdxfGOWusuvJIpBhrrSIoUGGZ4ipqWpJc7EgQZ256fA15nIl5fNzyI_oGlzBoC0Uyhu3t2fvD_Ss-3jxCnFuqpKzxU3VNyK0VvWxazT9tAv1tiyoo2nc7vIdzhIRRhLLx5OqjB94O8k0-T47bKWSy9w6yJkeYsNNamSezwXx9zeo3NOVYVQ"
                                       Aspect="AspectFill" />
                            </Border>

                            <Border HorizontalOptions="End"
                                    VerticalOptions="Start"
                                    Margin="12"
                                    Padding="10,2"
                                    StrokeShape="RoundRectangle 12"
                                    BackgroundColor="#E6FFFFFF"
                                    Stroke="Transparent">
                                <Label Text="$"
                                       FontSize="12"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource PrimaryText}" />
                            </Border>
                        </Grid>

                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="0">
                            <Grid Grid.ColumnSpan="2" ColumnDefinitions="*,Auto">
                                <VerticalStackLayout Grid.Column="0">
                                    <Label Text="Leyli Muse Mutfak"
                                           FontSize="20"
                                           FontAttributes="Bold"
                                           FontFamily="Manrope"
                                           TextColor="{StaticResource PrimaryText}" />
                                    <HorizontalStackLayout Spacing="4">
                                        <Image Source="ic_location_on.png" WidthRequest="16" HeightRequest="16" />
                                        <Label Text="Traditional • 0.5 km"
                                               FontSize="12"
                                               TextColor="{StaticResource SecondaryText}" />
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                            </Grid>

                            <HorizontalStackLayout Grid.Column="2" HorizontalOptions="End" Spacing="4" VerticalOptions="Center">
                                <Image Source="ic_star_filled.png" WidthRequest="18" HeightRequest="18" />
                                <Label Text="4.6"
                                       FontSize="12"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource PrimaryText}" />
                            </HorizontalStackLayout>
                        </Grid>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Bottom Navigation Bar -->
        <Border Grid.Row="2"
                StrokeShape="RoundRectangle 16,16,0,0"
                BackgroundColor="#E6FDFCFB"
                Stroke="Transparent"
                Padding="16,8">
            <Border.Shadow>
                <Shadow Brush="#C5A880" Offset="0,-4" Radius="12" Opacity="0.15" />
            </Border.Shadow>

            <Grid ColumnDefinitions="*,*,*,*">
                <!-- Home -->
                <VerticalStackLayout Grid.Column="0" HorizontalOptions="Center" Spacing="2">
                    <Image Source="ic_home.png" WidthRequest="24" HeightRequest="24" />
                    <Label Text="Home" FontSize="12" TextColor="{StaticResource SecondaryText}" HorizontalOptions="Center" />
                </VerticalStackLayout>

                <!-- Discover (Active State) -->
                <Border Grid.Column="1"
                        BackgroundColor="#4D93F2F2"
                        StrokeShape="RoundRectangle 20"
                        Padding="16,4"
                        HorizontalOptions="Center">
                    <VerticalStackLayout Spacing="2">
                        <Image Source="ic_explore_filled.png" WidthRequest="24" HeightRequest="24" />
                        <Label Text="Discover" FontSize="12" TextColor="{StaticResource PrimaryBrand}" FontAttributes="Bold" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>

                <!-- Favorites -->
                <VerticalStackLayout Grid.Column="2" HorizontalOptions="Center" Spacing="2">
                    <Image Source="ic_favorite.png" WidthRequest="24" HeightRequest="24" />
                    <Label Text="Favorites" FontSize="12" TextColor="{StaticResource SecondaryText}" HorizontalOptions="Center" />
                </VerticalStackLayout>

                <!-- Profile -->
                <VerticalStackLayout Grid.Column="3" HorizontalOptions="Center" Spacing="2">
                    <Image Source="ic_person.png" WidthRequest="24" HeightRequest="24" />
                    <Label Text="Profile" FontSize="12" TextColor="{StaticResource SecondaryText}" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Grid>
        </Border>

    </Grid>

</ContentPage>