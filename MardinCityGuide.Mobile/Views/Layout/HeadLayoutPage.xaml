<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MardinCityGuide.Mobile.Views.Layout.HeadLayoutPage">


    <!-- ================= 1. TOP APP BAR (SABİT ÜST BAR) ================= -->
    <Border Grid.Row="0" 
                BackgroundColor="#CCFDFCFB" 
                StrokeThickness="0" 
                HeightRequest="64" 
                Padding="20,0">
        <Grid ColumnDefinitions="*, Auto">
            <!-- Logo / Başlık -->
            <Label Grid.Column="0" 
                       Text="Mardin Şehir Rehberi" 
                       FontSize="22" 
                       FontAttributes="Bold" 
                       TextColor="#725B38" 
                       VerticalOptions="Center" />

            <!-- Sağ İkonlar (Arama & Bildirim) -->
            <HorizontalStackLayout Grid.Column="1" Spacing="16" VerticalOptions="Center">
                <Label Text="&#xe8b6;" 
                           FontFamily="MaterialSymbols" 
                           FontSize="24" 
                           TextColor="#725B38" 
                           VerticalOptions="Center" />
                <Label Text="&#xe7f4;" 
                           FontFamily="MaterialSymbols" 
                           FontSize="24" 
                           TextColor="#725B38" 
                           VerticalOptions="Center" />
            </HorizontalStackLayout>
        </Grid>
    </Border>

</ContentView>
