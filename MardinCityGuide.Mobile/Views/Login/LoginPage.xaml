<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MardinCityGuide.Mobile.Views.Login.LoginPage"
             BackgroundColor="#FBF9F6"
             NavigationPage.HasNavigationBar="False">

    <ScrollView VerticalScrollBarVisibility="Never">
        <Grid HorizontalOptions="FillAndExpand" VerticalOptions="CenterAndExpand" Padding="20">

            <!-- VisualStateManager ile Ekran Genişliğine Göre Dinamik Stil -->
            <Grid x:Name="MainGrid" MaximumWidthRequest="900" HorizontalOptions="Center">
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup x:Name="AdaptiveStates">
                        <!-- Mobil / Dar Ekran Durumu (Genişlik < 768px) -->
                        <VisualState x:Name="Narrow">
                            <VisualState.StateTriggers>
                                <AdaptiveTrigger MinWindowWidth="0" />
                            </VisualState.StateTriggers>
                            <VisualState.Setters>
                                <Setter Property="ColumnDefinitions" Value="*" />
                                <Setter TargetName="SpotlightCard" Property="IsVisible" Value="False" />
                            </VisualState.Setters>
                        </VisualState>

                        <!-- Geniş Ekran / Desktop / Tablet Durumu (Genişlik >= 768px) -->
                        <VisualState x:Name="Wide">
                            <VisualState.StateTriggers>
                                <AdaptiveTrigger MinWindowWidth="768" />
                            </VisualState.StateTriggers>
                            <VisualState.Setters>
                                <Setter Property="ColumnDefinitions" Value="*, 340" />
                                <Setter TargetName="SpotlightCard" Property="IsVisible" Value="True" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>

                <!-- ================= 1. GİRİŞ FORMU (SOL KISIM) ================= -->
                <VerticalStackLayout Grid.Column="0" Spacing="24" MaximumWidthRequest="420" HorizontalOptions="Center">

                    <!-- Brand Header -->
                    <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                        <Border BackgroundColor="#EFEEEB" StrokeThickness="1" Stroke="#D1C5B8" WidthRequest="64" HeightRequest="64" HorizontalOptions="Center">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="32" />
                            </Border.StrokeShape>
                            <Label Text="&#xe88a;" FontFamily="MaterialSymbols" FontSize="32" TextColor="#725B38" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>

                        <Label Text="Mardin Şehir Rehberi" FontSize="32" FontAttributes="Bold" TextColor="#725B38" HorizontalTextAlignment="Center" />

                        <Label Text="Altın şehrin kucağına adım atın." FontSize="14" TextColor="#4D463C" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>

                    <!-- Main Login Card -->
                    <Border BackgroundColor="White" Stroke="#D1C5B8" StrokeThickness="0.5" Padding="24">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20" />
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="#C5A880" Offset="0,8" Radius="16" Opacity="0.2" />
                        </Border.Shadow>

                        <VerticalStackLayout Spacing="16">

                            <!-- Email Field -->
                            <VerticalStackLayout Spacing="6">
                                <Label Text="Kullanıcı Adı" FontSize="13" TextColor="#4D463C" FontAttributes="Bold" />
                                <Border BackgroundColor="#F5F3F0" StrokeThickness="0" HeightRequest="50">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="12" />
                                    </Border.StrokeShape>
                                    <Grid ColumnDefinitions="48, *">
                                        <Label Grid.Column="0" Text="&#xe0be;" FontFamily="MaterialSymbols" FontSize="18" TextColor="#7F766A" HorizontalOptions="Center" 
                                           VerticalOptions="Center" />
                                        <Entry x:Name="UserNameEntry" Grid.Column="1" Placeholder="Kullanıcı Adınız" Keyboard="Text" PlaceholderColor="#D1C5B8" TextColor="#1B1C1A" VerticalOptions="Center" />
                                    </Grid>
                                </Border>
                            </VerticalStackLayout>

                            <!-- Password Field -->
                            <VerticalStackLayout Spacing="6">
                                <Label Text="Parola" FontSize="13" TextColor="#4D463C" FontAttributes="Bold" />
                                <Border BackgroundColor="#F5F3F0" StrokeThickness="0" HeightRequest="50">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="12" />
                                    </Border.StrokeShape>
                                    <Grid ColumnDefinitions="48, *, 48">
                                        <Label Grid.Column="0" Text="&#xe897;" FontFamily="MaterialSymbols" FontSize="18" TextColor="#7F766A" HorizontalOptions="Center" VerticalOptions="Center" />

                                        <Entry x:Name="PasswordHashEntry" Grid.Column="1" IsPassword="True" Placeholder="••••••••" PlaceholderColor="#D1C5B8" TextColor="#1B1C1A" VerticalOptions="Center" />

                                        <Button x:Name="TogglePasswordBtn" Grid.Column="2" Text="&#xe8f4;" FontFamily="MaterialSymbols" FontSize="20" TextColor="#7F766A" BackgroundColor="Transparent" Padding="0" Clicked="OnTogglePasswordClicked" />
                                    </Grid>
                                </Border>
                            </VerticalStackLayout>

                            <!-- Remember Me & Forgot Password -->
                            <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                                <HorizontalStackLayout Grid.Column="0" Spacing="8" VerticalOptions="Center">
                                    <CheckBox Color="#C5A880" VerticalOptions="Center" />
                                    <Label Text="Beni Hatırla " FontSize="13" TextColor="#4D463C" VerticalOptions="Center" />
                                </HorizontalStackLayout>

                                <Label Grid.Column="1" Text=" Şifrenizi mi unuttunuz?" FontSize="13" TextColor="#725B38" FontAttributes="Bold" VerticalOptions="Center">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnForgotPasswordTapped" />
                                    </Label.GestureRecognizers>
                                </Label>
                            </Grid>

                            <!-- Sign In Button -->
                            <Button Text="Giriş Yap" BackgroundColor="#C5A880" TextColor="White" FontAttributes="Bold" FontSize="16" CornerRadius="26" HeightRequest="50" Margin="0,8,0,0" Clicked="OnSignInClicked" />

                            <!-- Divider -->
                            <Grid ColumnDefinitions="*, Auto, *" Margin="0,12,0,4">
                                <BoxView Grid.Column="0" HeightRequest="1" Color="#D1C5B8" VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="VEYA ŞUNUNLA DEVAM ET" FontSize="11" TextColor="#7F766A" FontAttributes="Bold" CharacterSpacing="1.2" Margin="12,0" />
                                <BoxView Grid.Column="2" HeightRequest="1" Color="#D1C5B8" VerticalOptions="Center" />
                            </Grid>

                            <!-- Social Logins -->
                            <Grid ColumnDefinitions="*, *" ColumnSpacing="12">
                                <Border Grid.Column="0" Stroke="#D1C5B8" StrokeThickness="1" HeightRequest="46" BackgroundColor="Transparent">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="12" />
                                    </Border.StrokeShape>
                                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="8" VerticalOptions="Center">
                                        <Label Text="G" TextColor="#725B38" FontAttributes="Bold" FontSize="16" VerticalOptions="Center" />
                                        <Label Text="Google" TextColor="#1B1C1A" FontAttributes="Bold" FontSize="14" VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </Border>

                                <Border Grid.Column="1" Stroke="#D1C5B8" StrokeThickness="1" HeightRequest="46" BackgroundColor="Transparent">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="12" />
                                    </Border.StrokeShape>
                                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="8" VerticalOptions="Center">
                                        <Label Text="" TextColor="#1B1C1A" FontSize="18" VerticalOptions="Center" />
                                        <Label Text="Apple" TextColor="#1B1C1A" FontAttributes="Bold" FontSize="14" VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </Border>
                            </Grid>

                        </VerticalStackLayout>
                    </Border>

                    <!-- Footer Redirect Link -->
                    <VerticalStackLayout Spacing="12" HorizontalOptions="Center">
                        <HorizontalStackLayout HorizontalOptions="Center">
                            <Label Text="Mardin'de yeni misiniz? " TextColor="#4D463C" FontSize="14" />
                            <Label Text="Hesap Oluştur" TextColor="#725B38" FontAttributes="Bold" FontSize="14">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnRegisterTapped" />
                                </Label.GestureRecognizers>
                            </Label>
                        </HorizontalStackLayout>

                        <HorizontalStackLayout Spacing="16" HorizontalOptions="Center">
                            <Label Text="Gizlilik Politikası" FontSize="12" TextColor="#7F766A" />
                            <Label Text="Hizmet Koşulları" FontSize="12" TextColor="#7F766A" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>

                </VerticalStackLayout>

                <!-- ================= 2. SPOTLIGHT KARTI (SAĞ KISIM - DİNAMİK) ================= -->
                <Border x:Name="SpotlightCard" Grid.Column="1" Margin="32,0,0,0" BackgroundColor="#FDFCFB" Stroke="#D1C5B8" StrokeThickness="0.5" Padding="16" VerticalOptions="Center" Rotation="2">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="20" />
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="#C5A880" Offset="0,10" Radius="20" Opacity="0.25" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="12">
                        <Border HeightRequest="320" StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            <Image Source="https://mardin.ktb.gov.tr/Resim/383890,mard-n-z-nc-r-ye-medreses--glcan-acar-1jpg.png?0" Aspect="AspectFill" />
                        </Border>

                        <Label Text="ÖNE ÇIKANLAR" FontSize="11" FontAttributes="Bold" TextColor="#D35400" CharacterSpacing="1.5" />
                        <Label Text="Zinciriye Medresesi" FontSize="18" FontAttributes="Bold" TextColor="#1B1C1A" />
                    </VerticalStackLayout>
                </Border>

            </Grid>
        </Grid>
    </ScrollView>

</ContentPage>