<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MardinCityGuide.Mobile.Views.TravelRoutes.TravelRoutesPage"
             BackgroundColor="#FDFCFB"
             NavigationPage.HasNavigationBar="False">

    <ContentPage.Resources>
        <ResourceDictionary>
            <!-- Custom Palette Colors -->
            <Color x:Key="SurfaceIvory">#FDFCFB</Color>
            <Color x:Key="PrimaryBrown">#725B38</Color>
            <Color x:Key="MesopotamianBlue">#008080</Color>
            <Color x:Key="MardinSand">#C5A880</Color>
            <Color x:Key="PrimaryFixed">#FEDEB2</Color>
            <Color x:Key="OnPrimaryFixed">#584323</Color>
            <Color x:Key="SurfaceContainer">#EFEEEB</Color>
            <Color x:Key="SurfaceContainerHigh">#EAE8E5</Color>
            <Color x:Key="OnSurfaceVariant">#4D463C</Color>
            <Color x:Key="GlassBorder">#33C5A880</Color>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto, *, Auto">

        <!-- 1. TOP APP BAR -->
        <Grid Grid.Row="0" 
              ColumnDefinitions="Auto, *, Auto" 
              Padding="16,12" 
              BackgroundColor="#CCFDFCFB" 
              HeightRequest="56">
            <ImageButton Grid.Column="0"
                         Source="icon_arrow_back.png"
                         HeightRequest="24"
                         WidthRequest="24"
                         VerticalOptions="Center"
                         BackgroundColor="Transparent" />

            <Label Grid.Column="1"
                   Text="Mardin Guide"
                   TextColor="{StaticResource PrimaryBrown}"
                   FontAttributes="Bold"
                   FontSize="20"
                   HorizontalOptions="Center"
                   VerticalOptions="Center" />

            <ImageButton Grid.Column="2"
                         Source="icon_search.png"
                         HeightRequest="24"
                         WidthRequest="24"
                         VerticalOptions="Center"
                         BackgroundColor="Transparent" />
        </Grid>

        <!-- 2. MAIN SCROLLABLE CONTENT -->
        <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Padding="20,16,20,32" Spacing="28">

                <!-- Header Section -->
                <VerticalStackLayout Spacing="6">
                    <Label Text="Özenle Seçilmiş Rotalar"
                           TextColor="{StaticResource PrimaryBrown}"
                           FontSize="28"
                           FontAttributes="Bold" />
                    <Label Text="Ustalıkla planlanmış yolculuklarla antik kentin ruhunu keşfedin."
                           TextColor="{StaticResource OnSurfaceVariant}"
                           FontSize="15"
                           LineBreakMode="WordWrap" />
                </VerticalStackLayout>

                <!-- Categories / Chips (Horizontal Scroll) -->
                <CollectionView x:Name="SelectedCategoryListCollection" HorizontalScrollBarVisibility="Never" SelectionMode="None">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Horizontal" ItemSpacing="8" />
                    </CollectionView.ItemsLayout>

                    <CollectionView.ItemTemplate>
                        <DataTemplate>

                            <Border StrokeShape="20" Padding="16,0" HeightRequest="36" StrokeThickness="0">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnCategorySelectionChanged" CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>

                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroupList>
                                        <VisualStateGroup x:Name="CommonStates">

                                            <!-- normal durum -->
                                            <VisualState x:Name="Normal">
                                                <VisualState.Setters>
                                                    <Setter Property="BackgroundColor" Value="{StaticResource SurfaceContainerHigh}" />
                                                    <Setter TargetName="CategoryLabel" Property="Label.TextColor" Value="{StaticResource OnSurfaceVariant}" />
                                                    <Setter TargetName="CategoryLabel" Property="Label.FontAttributes" Value="None" />
                                                </VisualState.Setters>
                                            </VisualState>

                                            <!-- seçili durum -->
                                            <VisualState x:Name="Selected">
                                                <VisualState.Setters>
                                                    <Setter Property="BackgroundColor" Value="{StaticResource MardinSand}" />
                                                    <Setter TargetName="CategoryLabel" Property="Label.TextColor" Value="White" />
                                                    <Setter TargetName="CategoryLabel" Property="Label.FontAttributes" Value="None" />
                                                </VisualState.Setters>
                                            </VisualState>

                                        </VisualStateGroup>
                                    </VisualStateGroupList>
                                </VisualStateManager.VisualStateGroups>

                                <Label x:Name="CategoryLabel" Text="{Binding CategoryName}" FontSize="12" VerticalOptions="Center" HorizontalOptions="Center" />
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- SECTION 1: 1 Day in Old Mardin Route -->
                <VerticalStackLayout Spacing="16" x:Name="GetOneRandomRoute">
                    <!-- Title & Duration Header -->
                    <Grid ColumnDefinitions="*, Auto">
                        <Label Grid.Column="0" 
                               Text="{Binding Name}"
                               TextColor="{StaticResource PrimaryBrown}"
                               FontSize="20"
                               FontAttributes="Bold" />
                        <Label Grid.Column="1" 
                               TextColor="{StaticResource MesopotamianBlue}"
                               FontSize="12"
                               FontAttributes="Bold"
                               VerticalOptions="End">

                            <Label.Text>
                                <MultiBinding StringFormat="{}{0} • Merkeze Uzaklık {1} Km">
                                    <Binding Path="DurationLabel"></Binding>
                                    <Binding Path="DistanceKm"></Binding>
                                </MultiBinding>
                            </Label.Text>
                            
                        </Label>
                    </Grid>

                    <!-- Route Hero Image Box -->
                    <Border StrokeShape="RoundRectangle 16"
                            HeightRequest="190"
                            StrokeThickness="0">
                        <Grid>
                            <Image Source="{Binding CoverImageUrl}" Aspect="AspectFill" />
                            <BoxView Color="#55000000" />

                            <Grid ColumnDefinitions="*, Auto" 
                                  VerticalOptions="End" 
                                  Padding="16">
                                <HorizontalStackLayout Grid.Column="0" Spacing="6" VerticalOptions="Center">
                                    <Image Source="icon_explore_white.png" WidthRequest="16" HeightRequest="16" />
                                    <Label Text="{Binding Description}" TextColor="White" FontSize="13" FontAttributes="Bold" />
                                </HorizontalStackLayout>

                                <Border Grid.Column="1"
                                        StrokeShape="RoundRectangle 14"
                                        BackgroundColor="#44FFFFFF"
                                        StrokeThickness="0"
                                        Padding="12,6"
                                        >
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnViewMapTapped" CommandParameter="{Binding MapUrl}" />
                                    </Border.GestureRecognizers>
                                    <Label Text="Haritayı Görüntüle" TextColor="White" FontSize="12" FontAttributes="Bold" />
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Step-by-Step Timeline Container -->
                    <CollectionView x:Name="RouteStopListByRouteIdCollection"
                SelectionMode="None"
                Margin="0,8,0,0">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Vertical" ItemSpacing="0" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="32, *" Margin="0,0,0,16">
                                    <!-- Timeline Çizgisi ve Adım Numarası -->
                                    <Grid Grid.Column="0">
                                        <BoxView Color="{StaticResource MardinSand}" WidthRequest="2" HorizontalOptions="Center" Margin="0,12,0,-16" />
                                        <Border StrokeShape="RoundRectangle 12" BackgroundColor="{StaticResource PrimaryFixed}" WidthRequest="24" HeightRequest="24" HorizontalOptions="Center" VerticalOptions="Start" Stroke="White" StrokeThickness="2">
                                            <Label Text="{Binding SortOrder}" TextColor="{StaticResource OnPrimaryFixed}" FontSize="11" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                                        </Border>
                                    </Grid>

                                    <!-- Durak Kartı İçeriği -->
                                    <Border Grid.Column="1" StrokeShape="RoundRectangle 12" BackgroundColor="#B5FFFFFF" Stroke="{StaticResource GlassBorder}" StrokeThickness="1" Padding="12">
                                        <Grid ColumnDefinitions="64, *" ColumnSpacing="12">
                                            <!-- Görsel -->
                                            <Border Grid.Column="0" StrokeShape="RoundRectangle 8" HeightRequest="64" StrokeThickness="0">
                                                <Image Source="{Binding ImageUrl}" Aspect="AspectFill" />
                                            </Border>

                                            <!-- Başlık, Açıklama ve Saat Bilgisi -->
                                            <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                                <Label Text="{Binding StopName}" TextColor="{StaticResource PrimaryBrown}" FontAttributes="Bold" FontSize="14" />

                                                <Label Text="{Binding Description}" TextColor="{StaticResource OnSurfaceVariant}" FontSize="12" MaxLines="2" LineBreakMode="TailTruncation" />

                                                <HorizontalStackLayout Spacing="4" Margin="0,2,0,0">
                                                    <Image Source="icon_clock.png" WidthRequest="12" HeightRequest="12" VerticalOptions="Center"/>
                                                    <!-- Saat formatı / BestTimeLabel -->
                                                    <Label Text="{Binding BestTimeLabel}" TextColor="{StaticResource OnSurfaceVariant}" FontSize="10" VerticalOptions="Center"/>
                                                </HorizontalStackLayout>
                                            </VerticalStackLayout>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

                <!-- SECTION 2: Gastronomy & Wine Route henüz yapılmadı -->
                <VerticalStackLayout Spacing="12">
                    <Label Text="Gastronomi &amp; Bağ Rotaları"
                           TextColor="{StaticResource PrimaryBrown}"
                           FontSize="20"
                           FontAttributes="Bold" />

                    <Grid ColumnDefinitions="*, *" ColumnSpacing="12" HeightRequest="240">
                        <!-- Left Big Card -->
                        <Border Grid.Column="0" StrokeShape="RoundRectangle 16" StrokeThickness="0">
                            <Grid>
                                <Image Source="assyrian_wine.jpg" Aspect="AspectFill" />
                                <BoxView Color="#66000000" />
                                <VerticalStackLayout VerticalOptions="End" Padding="12" Spacing="2">
                                    <Label Text="Assyrian Wine Tasting" TextColor="White" FontSize="14" FontAttributes="Bold" />
                                    <Label Text="TRADITIONAL CELLARS" TextColor="#DDFFFFFF" FontSize="10" FontAttributes="Bold" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>

                        <!-- Right Column (Small Card + Rating Box) -->
                        <Grid Grid.Column="1" RowDefinitions="*, *" RowSpacing="12">
                            <!-- Top Image -->
                            <Border Grid.Row="0" StrokeShape="RoundRectangle 16" StrokeThickness="0">
                                <Image Source="mardin_kebab.jpg" Aspect="AspectFill" />
                            </Border>

                            <!-- Bottom Info Box -->
                            <Border Grid.Row="1" 
                                    StrokeShape="RoundRectangle 16" 
                                    BackgroundColor="#C5A880"
                                    StrokeThickness="0"
                                    Padding="14">
                                <VerticalStackLayout VerticalOptions="Center" Spacing="4">
                                    <Label Text="6 Expert Culinary Stops" TextColor="{StaticResource OnPrimaryFixed}" FontAttributes="Bold" FontSize="14" LineBreakMode="WordWrap" />
                                    <HorizontalStackLayout Spacing="4">
                                        <Image Source="icon_star.png" WidthRequest="12" HeightRequest="12" VerticalOptions="Center" />
                                        <Label Text="4.9" TextColor="{StaticResource OnPrimaryFixed}" FontAttributes="Bold" FontSize="12" VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                            </Border>
                        </Grid>
                    </Grid>
                </VerticalStackLayout>

                <!-- SECTION 3: Photography Route -->
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*, Auto">
                        <Label Grid.Column="0"
                               Text="Fotoğrafçılık Rotaları
"
                               TextColor="{StaticResource PrimaryBrown}"
                               FontSize="20"
                               FontAttributes="Bold" />
                        <Image Grid.Column="1"
                               Source="icon_camera.png"
                               WidthRequest="22" HeightRequest="22"
                               VerticalOptions="Center" />
                    </Grid>

                    <!-- Horizontal Spots Carousel -->
                    <ScrollView HorizontalScrollBarVisibility="Never" Orientation="Horizontal" Margin="-20,0">
                        <HorizontalStackLayout Spacing="14" Padding="20,0">

                            <!-- Spot 1 -->
                            <VerticalStackLayout WidthRequest="180" Spacing="6">
                                <Border StrokeShape="RoundRectangle 12" HeightRequest="225" StrokeThickness="0">
                                    <Image Source="blue_doors.jpg" Aspect="AspectFill" />
                                </Border>
                                <Label Text="The Blue Doors" TextColor="{StaticResource PrimaryBrown}" FontAttributes="Bold" FontSize="14" />
                                <Label Text="Best at 10:00 AM" TextColor="{StaticResource OnSurfaceVariant}" FontSize="11" />
                            </VerticalStackLayout>

                            <!-- Spot 2 -->
                            <VerticalStackLayout WidthRequest="180" Spacing="6">
                                <Border StrokeShape="RoundRectangle 12" HeightRequest="225" StrokeThickness="0">
                                    <Image Source="abbara_shadows.jpg" Aspect="AspectFill" />
                                </Border>
                                <Label Text="Abbara Shadows" TextColor="{StaticResource PrimaryBrown}" FontAttributes="Bold" FontSize="14" />
                                <Label Text="Best at 03:00 PM" TextColor="{StaticResource OnSurfaceVariant}" FontSize="11" />
                            </VerticalStackLayout>

                            <!-- Spot 3 -->
                            <VerticalStackLayout WidthRequest="180" Spacing="6">
                                <Border StrokeShape="RoundRectangle 12" HeightRequest="225" StrokeThickness="0">
                                    <Image Source="minaret_sunset.jpg" Aspect="AspectFill" />
                                </Border>
                                <Label Text="Minaret Sunset" TextColor="{StaticResource PrimaryBrown}" FontAttributes="Bold" FontSize="14" />
                                <Label Text="Best at 07:30 PM" TextColor="{StaticResource OnSurfaceVariant}" FontSize="11" />
                            </VerticalStackLayout>

                        </HorizontalStackLayout>
                    </ScrollView>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <!-- 3. BOTTOM NAVIGATION BAR -->
        <Border Grid.Row="2"
                StrokeShape="RoundRectangle 16,16,0,0"
                BackgroundColor="#E6FDFCFB"
                StrokeThickness="0"
                Padding="8,10"
                Margin="0">
            <Grid ColumnDefinitions="*, *, *, *">

                <!-- Home -->
                <VerticalStackLayout Grid.Column="0" HorizontalOptions="Center" Spacing="2">
                    <Image Source="nav_home.png" HeightRequest="22" WidthRequest="22" HorizontalOptions="Center" />
                    <Label Text="Home" TextColor="{StaticResource OnSurfaceVariant}" FontSize="11" HorizontalOptions="Center" />
                </VerticalStackLayout>

                <!-- Discover (Active Tab) -->
                <Border Grid.Column="1" 
                        StrokeShape="RoundRectangle 16"
                        BackgroundColor="#33FEDEB2"
                        StrokeThickness="0"
                        Padding="14,4"
                        HorizontalOptions="Center">
                    <VerticalStackLayout Spacing="2">
                        <Image Source="nav_discover_active.png" HeightRequest="22" WidthRequest="22" HorizontalOptions="Center" />
                        <Label Text="Discover" TextColor="{StaticResource PrimaryBrown}" FontAttributes="Bold" FontSize="11" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>

                <!-- Favorites -->
                <VerticalStackLayout Grid.Column="2" HorizontalOptions="Center" Spacing="2">
                    <Image Source="nav_favorites.png" HeightRequest="22" WidthRequest="22" HorizontalOptions="Center" />
                    <Label Text="Favorites" TextColor="{StaticResource OnSurfaceVariant}" FontSize="11" HorizontalOptions="Center" />
                </VerticalStackLayout>

                <!-- Profile -->
                <VerticalStackLayout Grid.Column="3" HorizontalOptions="Center" Spacing="2">
                    <Image Source="nav_profile.png" HeightRequest="22" WidthRequest="22" HorizontalOptions="Center" />
                    <Label Text="Profile" TextColor="{StaticResource OnSurfaceVariant}" FontSize="11" HorizontalOptions="Center" />
                </VerticalStackLayout>

            </Grid>
        </Border>

    </Grid>

</ContentPage>