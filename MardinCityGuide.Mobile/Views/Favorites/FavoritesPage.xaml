<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MardinCityGuide.Mobile.Views.Favorites.FavoritesPage"
             BackgroundColor="#FDFCFB"
             Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <ResourceDictionary>
            <!-- Custom Palette Colors -->
            <Color x:Key="SurfaceIvory">#FDFCFB</Color>
            <Color x:Key="PrimaryBrown">#725B38</Color>
            <Color x:Key="MesopotamianBlue">#008080</Color>
            <Color x:Key="MardinSand">#C5A880</Color>
            <Color x:Key="PrimaryFixed">#FEDEB2</Color>
            <Color x:Key="OnPrimaryFixed">#584323</Color>
            <Color x:Key="SurfaceContainer">#EFEEEB</Color>
            <Color x:Key="SurfaceContainerHigh">#EAE8E5</Color>
            <Color x:Key="OnSurfaceVariant">#4D463C</Color>
            <Color x:Key="GlassBorder">#33C5A880</Color>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- 1. TOP APP BAR -->
        <Grid Grid.Row="0"
              HeightRequest="64"
              Padding="20,0"
              ColumnDefinitions="Auto,*,Auto"
              BackgroundColor="#CCFDFCFB">

            <HorizontalStackLayout Grid.Column="0" Spacing="16" VerticalOptions="Center">
                <ImageButton Source="ic_arrow_back.png"
                             HeightRequest="24"
                             WidthRequest="24"
                             BackgroundColor="Transparent" />
                <Label Text="Favorites"
                       FontFamily="ManropeBold"
                       FontSize="20"
                       TextColor="#725B38"
                       VerticalOptions="Center" />
            </HorizontalStackLayout>

            <ImageButton Grid.Column="2"
                         Source="ic_search.png"
                         HeightRequest="24"
                         WidthRequest="24"
                         BackgroundColor="Transparent"
                         VerticalOptions="Center" />
        </Grid>

        <!-- 2. MAIN SCROLL CONTENT -->
        <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Padding="20,0,20,24" Spacing="16">

                <!-- TAB CHIPS (Filtre Butonları) SelectedFavoriteTypeListCollection -->

                <CollectionView x:Name="SelectedFavoriteTypeListCollection" HorizontalScrollBarVisibility="Never" SelectionMode="None">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Horizontal" ItemSpacing="8" />
                    </CollectionView.ItemsLayout>

                    <CollectionView.ItemTemplate>
                        <DataTemplate>

                            <Border StrokeShape="20" Padding="16,0" HeightRequest="36" StrokeThickness="0">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnFavoriteTypeSelectionChanged" CommandParameter="{Binding Value}" />
                                </Border.GestureRecognizers>

                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroupList>
                                        <VisualStateGroup x:Name="CommonStates">

                                            <!-- normal durum -->
                                            <VisualState x:Name="Normal">
                                                <VisualState.Setters>
                                                    <Setter Property="BackgroundColor" Value="#EAE8E5" />
                                                    <Setter TargetName="FavoriteLabel" Property="Label.TextColor" Value="#4D463C" />
                                                    <Setter TargetName="FavoriteLabel" Property="Label.FontAttributes" Value="None" />
                                                </VisualState.Setters>
                                            </VisualState>

                                            <!-- seçili durum -->
                                            <VisualState x:Name="Selected">
                                                <VisualState.Setters>
                                                    <Setter Property="BackgroundColor" Value="#C5A880" />
                                                    <Setter TargetName="FavoriteLabel" Property="Label.TextColor" Value="White" />
                                                    <Setter TargetName="FavoriteLabel" Property="Label.FontAttributes" Value="None" />
                                                </VisualState.Setters>
                                            </VisualState>

                                        </VisualStateGroup>
                                    </VisualStateGroupList>
                                </VisualStateManager.VisualStateGroups>

                                <Label x:Name="FavoriteLabel" Text="{Binding Text}" FontSize="12" VerticalOptions="Center" HorizontalOptions="Center" />
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                
                <!-- STATS HEADER -->
                <Label Margin="0,4,0,8">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="You have " TextColor="#4D463C" FontFamily="BeVietnamProRegular" FontSize="16" />
                            <Span Text="4" TextColor="#725B38" FontFamily="BeVietnamProBold" FontSize="16" />
                            <Span Text=" places saved in Mardin." TextColor="#4D463C" FontFamily="BeVietnamProRegular" FontSize="16" />
                        </FormattedString>
                    </Label.FormattedText>
                </Label>

                <Label FormattedText="{StaticResource SavedCountString}" Margin="0,4,0,8" />

                <!-- FAVORITES LIST (STATİK KARTLAR) -->
                <VerticalStackLayout Spacing="16">
                <CollectionView x:Name="FavoritesCollection" VerticalScrollBarVisibility="Never">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="16"></LinearItemsLayout>
                    </CollectionView.ItemsLayout>

                    <CollectionView.ItemTemplate>
                        <DataTemplate>

                            <!-- FAVORİ KART 1 -->
                            <Border StrokeShape="RoundRectangle 12" StrokeThickness="0" BackgroundColor="#FFFFFF" HeightRequest="128">
                                <Border.Shadow>
                                    <Shadow Brush="#C5A880" Offset="0,4" Radius="12" Opacity="0.15" />
                                </Border.Shadow>

                                <Grid ColumnDefinitions="128,*">
                                    <!-- Sol Görsel & Rating -->
                                    <Grid Grid.Column="0">
                                        <Image Source="{Binding ImageUrl}" Aspect="AspectFill" />

                                        <Border HorizontalOptions="Start" VerticalOptions="Start" Margin="8" BackgroundColor="#CCFFFFFF" StrokeShape="RoundRectangle 10" StrokeThickness="0" Padding="6,2">
                                            <HorizontalStackLayout Spacing="2">
                                                <Label Text="★" TextColor="#D35400" FontSize="10" VerticalOptions="Center" />
                                                <Label Text="{Binding Rating}" FontFamily="BeVietnamProBold" FontSize="10" TextColor="#D35400" VerticalOptions="Center" />
                                            </HorizontalStackLayout>
                                        </Border>
                                    </Grid>

                                    <!-- Sağ Bilgi Alanı -->
                                    <Grid Grid.Column="1" Padding="16,12" RowDefinitions="*,Auto">
                                        <VerticalStackLayout Grid.Row="0" Spacing="2">
                                            <Label Text="{Binding Title}" FontFamily="ManropeSemiBold" FontSize="18" TextColor="#1B1C1A" LineBreakMode="TailTruncation" />

                                            <HorizontalStackLayout Spacing="4">
                                                <Image Source="ic_location.png" HeightRequest="14" WidthRequest="14" VerticalOptions="Center" />
                                                <Label Text="{Binding Location}" FontFamily="BeVietnamProSemiBold" FontSize="12" TextColor="#4D463C" VerticalOptions="Center" />
                                            </HorizontalStackLayout>
                                        </VerticalStackLayout>

                                        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" VerticalOptions="End">
                                            <Border Grid.Column="0" HorizontalOptions="Start" BackgroundColor="#EAE8E5" StrokeShape="RoundRectangle 6" StrokeThickness="0" Padding="8,2">
                                                <Label Text="{Binding CategoryTag}" FontFamily="BeVietnamProSemiBold" FontSize="10" TextColor="#4D463C" />
                                            </Border>

                                            <ImageButton Grid.Column="1" Source="ic_heart_filled.png" HeightRequest="32" WidthRequest="32" CornerRadius="16" BackgroundColor="#1AD35400" /> <!--buraya clicked özelliği gelecek-->
                                        </Grid>
                                    </Grid>
                                </Grid>
                            </Border>

                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                    
                </CollectionView>
                </VerticalStackLayout>
               
                <!-- 3. RECOMMENDED SECTION HEADER -->
                <Grid ColumnDefinitions="*,Auto" Margin="0,16,0,0">
                    <Label Grid.Column="0"
                           Text="Sizin İçin Önerilenler"
                           FontFamily="ManropeSemiBold"
                           FontSize="20"
                           TextColor="#1B1C1A" />
                    <Button Grid.Column="1"
                            Text="See All"
                            FontFamily="BeVietnamProMedium"
                            FontSize="14"
                            TextColor="#008080"
                            BackgroundColor="Transparent"
                            Padding="0" />
                </Grid>

                <!-- ÖNERİLENLER LİSTESİ (YATAY SCROLL) -->
                <CollectionView HorizontalScrollBarVisibility="Never" x:Name="RecommendedReligiousSiteCollection">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Horizontal" ItemSpacing="16"></LinearItemsLayout>
                    </CollectionView.ItemsLayout>

                    <CollectionView.ItemTemplate>
                        <DataTemplate>

                            <!-- Öneri 1 -->
                            <VerticalStackLayout WidthRequest="180" Spacing="6">
                                <Grid HeightRequest="225">
                                    <Border StrokeShape="RoundRectangle 12" StrokeThickness="0">
                                        <Image Source="{Binding ImageUrl}" Aspect="AspectFill" />
                                    </Border>
                                    <ImageButton Source="ic_add.png" Clicked="OnAddFavoriteClicked" CommandParameter="{Binding ReligiousSiteId}" HorizontalOptions="End" VerticalOptions="Start" Margin="8" HeightRequest="28" WidthRequest="28" CornerRadius="14" BackgroundColor="#E6FFFFFF" />
                                </Grid>
                                <Label Text="{Binding Name}" FontFamily="ManropeSemiBold" FontSize="15" TextColor="#1B1C1A" LineBreakMode="TailTruncation" />
                                <Label Text="{Binding SiteType}" FontFamily="BeVietnamProSemiBold" FontSize="12" TextColor="#4D463C" />
                            </VerticalStackLayout>

                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
                
                <ScrollView HorizontalScrollBarVisibility="Never" Orientation="Horizontal">
                    <HorizontalStackLayout Spacing="16">

                        <!-- Öneri 1 -->
                        <VerticalStackLayout WidthRequest="180" Spacing="6">
                            <Grid HeightRequest="225">
                                <Border StrokeShape="RoundRectangle 12" StrokeThickness="0">
                                    <Image Source="deyrulzafaran.jpg" Aspect="AspectFill" />
                                </Border>
                                <ImageButton Source="ic_add.png"
                                             HorizontalOptions="End"
                                             VerticalOptions="Start"
                                             Margin="8"
                                             HeightRequest="28"
                                             WidthRequest="28"
                                             CornerRadius="14"
                                             BackgroundColor="#E6FFFFFF" />
                            </Grid>
                            <Label Text="Deyrulzafaran Monastery"
                                   FontFamily="ManropeSemiBold"
                                   FontSize="15"
                                   TextColor="#1B1C1A"
                                   LineBreakMode="TailTruncation" />
                            <Label Text="Historical Site"
                                   FontFamily="BeVietnamProSemiBold"
                                   FontSize="12"
                                   TextColor="#4D463C" />
                        </VerticalStackLayout>

                        <!-- Öneri 2 -->
                        <VerticalStackLayout WidthRequest="180" Spacing="6">
                            <Grid HeightRequest="225">
                                <Border StrokeShape="RoundRectangle 12" StrokeThickness="0">
                                    <Image Source="old_city_route.jpg" Aspect="AspectFill" />
                                </Border>
                                <ImageButton Source="ic_add.png"
                                             HorizontalOptions="End"
                                             VerticalOptions="Start"
                                             Margin="8"
                                             HeightRequest="28"
                                             WidthRequest="28"
                                             CornerRadius="14"
                                             BackgroundColor="#E6FFFFFF" />
                            </Grid>
                            <Label Text="Old City Walking Route"
                                   FontFamily="ManropeSemiBold"
                                   FontSize="15"
                                   TextColor="#1B1C1A"
                                   LineBreakMode="TailTruncation" />
                            <Label Text="Route"
                                   FontFamily="BeVietnamProSemiBold"
                                   FontSize="12"
                                   TextColor="#4D463C" />
                        </VerticalStackLayout>

                        <!-- Öneri 3 -->
                        <VerticalStackLayout WidthRequest="180" Spacing="6">
                            <Grid HeightRequest="225">
                                <Border StrokeShape="RoundRectangle 12" StrokeThickness="0">
                                    <Image Source="zinciriye.jpg" Aspect="AspectFill" />
                                </Border>
                                <ImageButton Source="ic_add.png"
                                             HorizontalOptions="End"
                                             VerticalOptions="Start"
                                             Margin="8"
                                             HeightRequest="28"
                                             WidthRequest="28"
                                             CornerRadius="14"
                                             BackgroundColor="#E6FFFFFF" />
                            </Grid>
                            <Label Text="Zinciriye Medrese"
                                   FontFamily="ManropeSemiBold"
                                   FontSize="15"
                                   TextColor="#1B1C1A"
                                   LineBreakMode="TailTruncation" />
                            <Label Text="Historical Site"
                                   FontFamily="BeVietnamProSemiBold"
                                   FontSize="12"
                                   TextColor="#4D463C" />
                        </VerticalStackLayout>

                    </HorizontalStackLayout>
                </ScrollView>

            </VerticalStackLayout>
        </ScrollView>

        <!-- 4. BOTTOM NAVIGATION BAR -->
        <Border Grid.Row="2"
                HeightRequest="64"
                StrokeShape="RoundRectangle 16,16,0,0"
                StrokeThickness="0"
                BackgroundColor="#E6FDFCFB">
            <Border.Shadow>
                <Shadow Brush="#C5A880" Offset="0,-4" Radius="12" Opacity="0.15" />
            </Border.Shadow>

            <Grid ColumnDefinitions="*,*,*,*">
                <VerticalStackLayout Grid.Column="0" VerticalOptions="Center" HorizontalOptions="Center" Spacing="2">
                    <Image Source="ic_home.png" HeightRequest="24" WidthRequest="24" />
                    <Label Text="Home" FontFamily="BeVietnamProSemiBold" FontSize="11" TextColor="#4D463C" />
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" HorizontalOptions="Center" Spacing="2">
                    <Image Source="ic_explore.png" HeightRequest="24" WidthRequest="24" />
                    <Label Text="Discover" FontFamily="BeVietnamProSemiBold" FontSize="11" TextColor="#4D463C" />
                </VerticalStackLayout>

                <!-- Active Tab: Favorites -->
                <Border Grid.Column="2"
                        BackgroundColor="#4DFEDB12"
                        StrokeShape="RoundRectangle 16"
                        StrokeThickness="0"
                        Padding="12,4"
                        HorizontalOptions="Center"
                        VerticalOptions="Center">
                    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="2">
                        <Image Source="ic_heart_active.png" HeightRequest="24" WidthRequest="24" />
                        <Label Text="Favorites" FontFamily="BeVietnamProSemiBold" FontSize="11" TextColor="#725B38" />
                    </VerticalStackLayout>
                </Border>

                <VerticalStackLayout Grid.Column="3" VerticalOptions="Center" HorizontalOptions="Center" Spacing="2">
                    <Image Source="ic_profile.png" HeightRequest="24" WidthRequest="24" />
                    <Label Text="Profile" FontFamily="BeVietnamProSemiBold" FontSize="11" TextColor="#4D463C" />
                </VerticalStackLayout>
            </Grid>
        </Border>

    </Grid>

</ContentPage>