<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MardinCityGuide.Mobile.Views.Favorites.FavoritesPage"
             BackgroundColor="#FDFCFB"
             Shell.NavBarIsVisible="False"
             NavigationPage.HasNavigationBar="False"
             ControlTemplate="{StaticResource MainLayoutTemplate}">
    
    <Grid RowDefinitions="*">

        <!-- 2. MAIN SCROLL CONTENT -->
        <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Padding="20,0,20,24" Spacing="16">

                <!-- TAB CHIPS (Filtre Butonları) SelectedFavoriteTypeListCollection -->

                <CollectionView x:Name="SelectedFavoriteTypeListCollection" HorizontalScrollBarVisibility="Never" SelectionMode="None">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Horizontal" ItemSpacing="8" />
                    </CollectionView.ItemsLayout>

                    <CollectionView.ItemTemplate>
                        <DataTemplate>

                            <Border StrokeShape="20" Padding="16,0" HeightRequest="36" StrokeThickness="0">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnFavoriteTypeSelectionChanged" CommandParameter="{Binding Value}" />
                                </Border.GestureRecognizers>

                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroupList>
                                        <VisualStateGroup x:Name="CommonStates">

                                            <!-- normal durum -->
                                            <VisualState x:Name="Normal">
                                                <VisualState.Setters>
                                                    <Setter Property="BackgroundColor" Value="#EAE8E5" />
                                                    <Setter TargetName="FavoriteLabel" Property="Label.TextColor" Value="#4D463C" />
                                                    <Setter TargetName="FavoriteLabel" Property="Label.FontAttributes" Value="None" />
                                                </VisualState.Setters>
                                            </VisualState>

                                            <!-- seçili durum -->
                                            <VisualState x:Name="Selected">
                                                <VisualState.Setters>
                                                    <Setter Property="BackgroundColor" Value="#C5A880" />
                                                    <Setter TargetName="FavoriteLabel" Property="Label.TextColor" Value="White" />
                                                    <Setter TargetName="FavoriteLabel" Property="Label.FontAttributes" Value="None" />
                                                </VisualState.Setters>
                                            </VisualState>

                                        </VisualStateGroup>
                                    </VisualStateGroupList>
                                </VisualStateManager.VisualStateGroups>

                                <Label x:Name="FavoriteLabel" Text="{Binding Text}" FontSize="12" VerticalOptions="Center" HorizontalOptions="Center" />
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>


                <!-- STATS HEADER -->
                <Label Margin="0,4,0,8">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="Favorilediğin " TextColor="#4D463C" FontFamily="BeVietnamProRegular" FontSize="16" />
                            <Span x:Name="FavoriteCount" TextColor="#725B38" FontFamily="BeVietnamProBold" FontSize="16" />
                            <Span Text=" Mekan Bulundu." TextColor="#4D463C" FontFamily="BeVietnamProRegular" FontSize="16" />
                        </FormattedString>
                    </Label.FormattedText>
                </Label>
                <!-- FAVORITES LIST (STATİK KARTLAR) -->
                <VerticalStackLayout Spacing="16">
                    <CollectionView x:Name="FavoritesCollection" VerticalScrollBarVisibility="Never">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Vertical" ItemSpacing="16"></LinearItemsLayout>
                        </CollectionView.ItemsLayout>

                        <CollectionView.ItemTemplate>
                            <DataTemplate>

                                <!-- FAVORİ KART 1 -->
                                <Border StrokeShape="RoundRectangle 12" StrokeThickness="0" BackgroundColor="#FFFFFF" HeightRequest="128">
                                    <Border.Shadow>
                                        <Shadow Brush="#C5A880" Offset="0,4" Radius="12" Opacity="0.15" />
                                    </Border.Shadow>

                                    <Grid ColumnDefinitions="128,*">
                                        <!-- Sol Görsel & Rating -->
                                        <Grid Grid.Column="0">
                                            <Image Source="{Binding ImageUrl}" Aspect="AspectFill" />

                                            <Border HorizontalOptions="Start" VerticalOptions="Start" Margin="8" BackgroundColor="#CCFFFFFF" StrokeShape="RoundRectangle 10" StrokeThickness="0" Padding="6,2">
                                                <HorizontalStackLayout Spacing="2">
                                                    <Label Text="★" TextColor="#D35400" FontSize="10" VerticalOptions="Center" />
                                                    <Label Text="{Binding Rating}" FontFamily="BeVietnamProBold" FontSize="10" TextColor="#D35400" VerticalOptions="Center" />
                                                </HorizontalStackLayout>
                                            </Border>
                                        </Grid>

                                        <!-- Sağ Bilgi Alanı -->
                                        <Grid Grid.Column="1" Padding="16,12" RowDefinitions="*,Auto">
                                            <VerticalStackLayout Grid.Row="0" Spacing="2">
                                                <Label Text="{Binding Title}" FontFamily="ManropeSemiBold" FontSize="18" TextColor="#1B1C1A" LineBreakMode="TailTruncation" />

                                                <HorizontalStackLayout Spacing="4">
                                                    <Label Text="&#xe0c8;" FontFamily="MaterialSymbols" HeightRequest="14" WidthRequest="14" VerticalOptions="Center" />
                                                    <Label Text="{Binding Location}" FontFamily="BeVietnamProSemiBold" FontSize="12" TextColor="#4D463C" VerticalOptions="Center" />
                                                </HorizontalStackLayout>
                                            </VerticalStackLayout>

                                            <Grid Grid.Row="1" ColumnDefinitions="*,Auto" VerticalOptions="End">
                                                <Border Grid.Column="0" HorizontalOptions="Start" BackgroundColor="#EAE8E5" StrokeShape="RoundRectangle 6" StrokeThickness="0" Padding="8,2">
                                                    <Label Text="{Binding CategoryTag}" FontFamily="BeVietnamProSemiBold" FontSize="10" TextColor="#4D463C" />
                                                </Border>

                                                <Button Grid.Column="1" Text="&#xe87d;" TextColor="{Binding IsFavoriteColor}" FontFamily="MaterialSymbols" HeightRequest="32" Clicked="OnAddFavoriteWithTargetClicked" WidthRequest="32" CornerRadius="16" BackgroundColor="#1AD35400">
                                                    <Button.CommandParameter>
                                                        <MultiBinding StringFormat="{}{0}:{1}">
                                                            <Binding Path="TargetId" />
                                                            <Binding Path="FavoriteType" />
                                                        </MultiBinding>
                                                    </Button.CommandParameter>
                                                </Button>
                                                <!--buraya clicked özelliği gelecek-->
                                            </Grid>
                                        </Grid>
                                    </Grid>
                                </Border>

                            </DataTemplate>
                        </CollectionView.ItemTemplate>

                    </CollectionView>
                </VerticalStackLayout>

                <!-- 3. RECOMMENDED SECTION HEADER -->
                <Grid ColumnDefinitions="*,Auto" Margin="0,16,0,0">
                    <Label Grid.Column="0"
                           Text="Sizin İçin Önerilenler"
                           FontFamily="ManropeSemiBold"
                           FontSize="20"
                           TextColor="#1B1C1A" />
                    <Button Grid.Column="1"
                            Text="Tümünü Gör"
                            FontFamily="BeVietnamProMedium"
                            FontSize="14"
                            TextColor="#008080"
                            BackgroundColor="Transparent"
                            Padding="0" />
                </Grid>

                <!-- ÖNERİLENLER LİSTESİ (YATAY SCROLL) -->
                <CollectionView HorizontalScrollBarVisibility="Never" x:Name="RecommendedReligiousSiteCollection">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Horizontal" ItemSpacing="16"></LinearItemsLayout>
                    </CollectionView.ItemsLayout>

                    <CollectionView.ItemTemplate>
                        <DataTemplate>

                            <!-- Öneri 1 -->
                            <VerticalStackLayout WidthRequest="180" Spacing="6">
                                <Grid HeightRequest="225">
                                    <Border StrokeShape="RoundRectangle 12" StrokeThickness="0">
                                        <Image Source="{Binding ImageUrl}" Aspect="AspectFill" />
                                    </Border>
                                    <Button Text="&#xef3a;" TextColor="{StaticResource MardinSand}" FontFamily="MaterialSymbols" Clicked="OnAddFavoriteClicked" CommandParameter="{Binding ReligiousSiteId}" HorizontalOptions="End" VerticalOptions="Start" Margin="8" HeightRequest="28" WidthRequest="28" CornerRadius="14" BackgroundColor="#E6FFFFFF" />
                                </Grid>
                                <Label Text="{Binding Name}" FontFamily="ManropeSemiBold" FontSize="15" TextColor="#1B1C1A" LineBreakMode="TailTruncation" />
                                <Label Text="{Binding SiteType}" FontFamily="BeVietnamProSemiBold" FontSize="12" TextColor="#4D463C" />
                            </VerticalStackLayout>

                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>

</ContentPage>