<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MardinCityGuide.Mobile.Views.Profile.ProfilePage"
             BackgroundColor="#FDFCFB"
             NavigationPage.HasNavigationBar="False">

    <Grid RowDefinitions="Auto, *, Auto">

        <!-- Top App Bar -->
        <Grid Grid.Row="0" 
              ColumnDefinitions="Auto, *, Auto" 
              Padding="20,12" 
              BackgroundColor="#FDFCFB" 
              HeightRequest="56">
            <ImageButton Grid.Column="0" 
                         Source="ic_arrow_back.png" 
                         HeightRequest="24" 
                         WidthRequest="24" 
                         VerticalOptions="Center" />
            <Label Grid.Column="1" 
                   Text="Profile" 
                   TextColor="#725b38" 
                   FontSize="20" 
                   FontAttributes="Bold" 
                   VerticalOptions="Center" 
                   Margin="16,0,0,0" />
            <ImageButton Grid.Column="2" 
                         Source="ic_search.png" 
                         HeightRequest="24" 
                         WidthRequest="24" 
                         VerticalOptions="Center" />
        </Grid>

        <!-- Main Content -->
        <ScrollView Grid.Row="1" Padding="20,16,20,24">
            <VerticalStackLayout Spacing="24">

                <!-- User Identity Section -->
                <VerticalStackLayout HorizontalOptions="Center" Spacing="8">
                    <!-- Profile Image with Edit Badge -->
                    <Grid WidthRequest="112" HeightRequest="112" HorizontalOptions="Center" Margin="0,0,0,8">
                        <Border WidthRequest="112" HeightRequest="112" StrokeShape="RoundRectangle 56" StrokeThickness="4" Stroke="#EFEEEB">
                            <Grid>
                                <!-- Kullanıcının gerçek profil fotoğrafı varsa bu çalışır -->
                                <Image x:Name="ImageAvatarUrl" Aspect="AspectFill" IsVisible="False" />

                                <!-- Resim yoksa doğrudan bu Vektörel Label çalışır (Sıfır Bulanıklık) -->
                                <Label x:Name="LabelAvatarIcon" Text="&#xe7fd;" FontFamily="MaterialSymbols" FontSize="56" TextColor="#7F766A" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Grid>
                        </Border>

                        <!-- Edit Button Badge -->
                        <Border WidthRequest="32" HeightRequest="32" BackgroundColor="#725b38" Stroke="#FDFCFB" StrokeThickness="2" HorizontalOptions="End" VerticalOptions="End">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="16" />
                            </Border.StrokeShape>
                            <Label Text="&#xe3c9;" FontFamily="MaterialSymbols" HeightRequest="20" WidthRequest="20" HorizontalOptions="End" TextColor="White" VerticalOptions="Center" />
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnSelectProfileImageTapped" />
                            </Border.GestureRecognizers>
                        </Border>
                    </Grid>

                    <Label x:Name="LabelName" TextColor="#1B1C1A" FontSize="24" FontAttributes="Bold" HorizontalTextAlignment="Center" />

                    <Label x:Name="LabelEmail" TextColor="#4D463C" FontSize="14" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>

                <!-- Stats Bento Grid -->
                <Grid ColumnDefinitions="*, *" ColumnSpacing="16">
                    <!-- Favorites Card -->
                    <Border Grid.Column="0" BackgroundColor="#F5F3F0" StrokeShape="RoundRectangle 16" StrokeThickness="1" Stroke="#1AD1C5B8" Padding="16,20">
                        <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                            <Label Text="&#xe87d;" TextColor="#725b38" FontSize="24" FontFamily="MaterialSymbols" HeightRequest="24" WidthRequest="24" />
                            <Label x:Name="FavoriteCount" TextColor="#725b38" FontSize="24" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                            <Label Text="Favoriler" TextColor="#4D463C" FontSize="11" FontAttributes="Bold" CharacterSpacing="1" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Routes Card -->
                    <Border Grid.Column="1" BackgroundColor="#F5F3F0" StrokeShape="RoundRectangle 16" StrokeThickness="1" Stroke="#1AD1C5B8" Padding="16,20">
                        <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                            <Label Text="&#xe55b;" TextColor="#725b38" FontSize="24" FontFamily="MaterialSymbols" HeightRequest="24" WidthRequest="24" />
                            <Label x:Name="MyRoutes" TextColor="#725b38" FontSize="24" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                            <Label Text="Rotalarım" TextColor="#4D463C" FontSize="11" FontAttributes="Bold" CharacterSpacing="1" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!-- Settings List -->
                <VerticalStackLayout Spacing="10">
                    <Label Text="Ayarlar" TextColor="#7F766A" FontSize="12" FontAttributes="Bold" CharacterSpacing="1.5" Margin="4,0,0,4" />

                    <!-- Account Information -->
                    <Border BackgroundColor="#FFFFFF" StrokeShape="RoundRectangle 16" StrokeThickness="0" Padding="12">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnAccountTapped" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="16" VerticalOptions="Center">
                            <Border Grid.Column="0" WidthRequest="40" HeightRequest="40" StrokeShape="RoundRectangle 40" BackgroundColor="#4DFEDEB2" StrokeThickness="0">
                                <Label Text="&#xe7fd;" FontFamily="MaterialSymbols" FontSize="20" HeightRequest="25" WidthRequest="20" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <Label Grid.Column="1" Text="Hesabım" TextColor="#1B1C1A" FontSize="16" VerticalOptions="Center" />
                            <Label Grid.Column="2" Text="&#xe5cc;" FontFamily="MaterialSymbols" FontSize="20" HeightRequest="20" WidthRequest="20" VerticalOptions="Center" />

                        </Grid>
                    </Border>

                    <!-- Notifications -->
                    <Border BackgroundColor="#FFFFFF" StrokeShape="RoundRectangle 16" StrokeThickness="0" Padding="12">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnNotificationsTapped" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="16" VerticalOptions="Center">
                            <Border Grid.Column="0" WidthRequest="40" HeightRequest="40" StrokeShape="RoundRectangle 20" BackgroundColor="#4DFEDEB2" StrokeThickness="0">
                                <Label Text="&#xe7f4;" FontFamily="MaterialSymbols" HeightRequest="25" FontSize="20"  WidthRequest="20" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <Label Grid.Column="1" Text="Notifications" TextColor="#1B1C1A" FontSize="16" VerticalOptions="Center" />
                            <Label Grid.Column="2" Text="&#xe5cc;" FontFamily="MaterialSymbols" FontSize="20"  HeightRequest="20" WidthRequest="20" VerticalOptions="Center" />
                        </Grid>
                    </Border>

                    <!-- Language -->
                    <Border BackgroundColor="#FFFFFF" StrokeShape="RoundRectangle 16" StrokeThickness="0" Padding="12">
                        <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="16" VerticalOptions="Center">
                            <Border Grid.Column="0" WidthRequest="40" HeightRequest="40" StrokeShape="RoundRectangle 20" BackgroundColor="#4DFEDEB2" StrokeThickness="0">
                                <Label Text="&#xe894;" HeightRequest="25" FontFamily="MaterialSymbols" FontSize="20" WidthRequest="20" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                <Label Text="Dil" TextColor="#1B1C1A" FontSize="16" />
                                <Label Text="Türkçe (TR)" TextColor="#4D463C" FontSize="12" />
                            </VerticalStackLayout>
                            <!--<Label Grid.Column="2" Text="&#xe5cc;" FontFamily="MaterialSymbols" FontSize="20"  HeightRequest="20" WidthRequest="20" VerticalOptions="Center" />-->
                        </Grid>
                    </Border>

                    <!-- Help & Support -->
                    <Border BackgroundColor="#FFFFFF" StrokeShape="RoundRectangle 16" StrokeThickness="0" Padding="12">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnSupportTapped" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="16" VerticalOptions="Center">
                            <Border Grid.Column="0" WidthRequest="40" HeightRequest="40" StrokeShape="RoundRectangle 20" BackgroundColor="#4DFEDEB2" StrokeThickness="0">
                                <Label Text="&#xe887;" FontFamily="MaterialSymbols" HeightRequest="20" WidthRequest="20" FontSize="20"  HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <Label Grid.Column="1" Text="Yardım &amp; Destek" TextColor="#1B1C1A" FontSize="16" VerticalOptions="Center" />
                            <Label Grid.Column="2" Text="&#xe5cc;" FontFamily="MaterialSymbols" FontSize="20"  HeightRequest="20" WidthRequest="20" VerticalOptions="Center" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <!-- Logout & Footer Section -->
                <VerticalStackLayout Spacing="20" Margin="0,8,0,12">
                    <Button Text="Çıkış Yap" TextColor="#725b38" BackgroundColor="Transparent" BorderColor="#725b38" BorderWidth="2" CornerRadius="25" HeightRequest="52" FontSize="16" FontAttributes="Bold" Clicked="OnLogoutCilcked">
                        <Button.ImageSource>
                            <FontImageSource Glyph="&#xe9ba;" 
                         FontFamily="MaterialSymbols" 
                         Color="#725b38" 
                         Size="20" />
                        </Button.ImageSource>
                    </Button>

                    <Label Text="Mardin Şehir Rehberi" 
                           TextColor="#7F766A" 
                           FontSize="12" 
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>


        <!-- 2. HESABIM GÜNCELLEME MODAL KATMANI -->
        <Grid x:Name="AccountModalOverlay" 
      Grid.Row="0"
      Grid.RowSpan="2"
      BackgroundColor="#80000000" 
      IsVisible="False"
      HorizontalOptions="Fill" 
      VerticalOptions="Fill">

            <!-- Yarı şeffaf siyah alana tıklandığında kapatmak için -->
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnCloseAccountModalTapped" />
            </Grid.GestureRecognizers>

            <!-- Kart Kutusu (Margin değerini tamamen kaldırdık) -->
            <Border VerticalOptions="Center" 
            HorizontalOptions="Center" 
            WidthRequest="340" 
            BackgroundColor="#FDFCFB" 
            Padding="24" 
            StrokeShape="RoundRectangle 20"
            StrokeThickness="0">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer />
                </Border.GestureRecognizers>

                <VerticalStackLayout Spacing="16">
                    <Label Text="Hesap Bilgileri" FontSize="18" FontAttributes="Bold" TextColor="#1B1C1A" />

                    <Entry x:Name="EntryName" Placeholder="Ad Soyad" TextColor="#1B1C1A" />
                    <Entry x:Name="EntryUserName" Placeholder="Kullanıcı Adı" TextColor="#1B1C1A" />
                    <Entry x:Name="EntryEmail" Placeholder="E-posta" TextColor="#1B1C1A" />

                    <Grid ColumnDefinitions="*, *" ColumnSpacing="10" Margin="0,10,0,0">
                        <Button Grid.Column="0" Text="İptal" BackgroundColor="Transparent" TextColor="#725b38" Clicked="OnCloseAccountModalTapped" />
                        <Button Grid.Column="1" Text="Kaydet" BackgroundColor="#725b38" TextColor="White" CornerRadius="10" Clicked="OnSaveAccountClicked" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Grid>


        <!-- 3. BİLDİRİM AYARLARI MODAL KATMANI -->
        <Grid Grid.Row="0" Grid.RowSpan="2" x:Name="NotificationModalOverlay" 
          BackgroundColor="#80000000" 
          IsVisible="False" 
          HorizontalOptions="Fill" 
          VerticalOptions="Fill">

                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCloseNotificationModalTapped" />
                    </Grid.GestureRecognizers>

                    <Border VerticalOptions="Center" 
                HorizontalOptions="Center" 
                WidthRequest="320" 
                BackgroundColor="#FDFCFB" 
                Padding="24" 
                StrokeShape="RoundRectangle 20"
                StrokeThickness="0">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer />
                        </Border.GestureRecognizers>

                        <VerticalStackLayout Spacing="20">
                            <Label Text="Bildirim Tercihleri" FontSize="18" FontAttributes="Bold" TextColor="#1B1C1A" />

                            <Grid ColumnDefinitions="*, Auto">
                                <Label Grid.Column="0" Text="Bildirimleri Al" FontSize="15" VerticalOptions="Center" TextColor="#1B1C1A" />
                                <Switch x:Name="SwitchNotifications" Grid.Column="1" OnColor="#725b38" ThumbColor="White" Toggled="OnNotificationToggled" />
                            </Grid>

                            <Button Text="Tamam" BackgroundColor="#725b38" TextColor="White" CornerRadius="10" Clicked="OnCloseNotificationModalTapped" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

        <!-- Bottom Navigation Bar -->
        <Border Grid.Row="2" 
                BackgroundColor="#EFFDFCFB" 
                StrokeShape="RoundRectangle 16,16,0,0" 
                StrokeThickness="0" 
                Padding="8,8,8,12" 
                HeightRequest="68">
            <Grid ColumnDefinitions="*, *, *, *">

                <!-- Home Tab -->
                <VerticalStackLayout Grid.Column="0" VerticalOptions="Center" HorizontalOptions="Center" Spacing="2">
                    <Image Source="ic_home.png" HeightRequest="22" WidthRequest="22" />
                    <Label Text="Home" TextColor="#4D463C" FontSize="11" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>

                <!-- Discover Tab -->
                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" HorizontalOptions="Center" Spacing="2">
                    <Image Source="ic_explore.png" HeightRequest="22" WidthRequest="22" />
                    <Label Text="Discover" TextColor="#4D463C" FontSize="11" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>

                <!-- Favorites Tab -->
                <VerticalStackLayout Grid.Column="2" VerticalOptions="Center" HorizontalOptions="Center" Spacing="2">
                    <Image Source="ic_favorite.png" HeightRequest="22" WidthRequest="22" />
                    <Label Text="Favorites" TextColor="#4D463C" FontSize="11" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>

                <!-- Active Profile Tab -->
                <Border Grid.Column="3" 
                        BackgroundColor="#4DFEDEB2" 
                        StrokeShape="RoundRectangle 20" 
                        StrokeThickness="0" 
                        Padding="12,6" 
                        HorizontalOptions="Center" 
                        VerticalOptions="Center">
                    <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                        <Image Source="ic_person_filled.png" HeightRequest="20" WidthRequest="20" />
                        <Label Text="Profile" TextColor="#725b38" FontSize="11" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>

            </Grid>
        </Border>

    </Grid>

</ContentPage>