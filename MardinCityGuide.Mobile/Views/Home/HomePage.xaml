<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MardinCityGuide.Mobile.Views.Home.HomePage"
             Title="Ana Sayfa"
             BackgroundColor="#FBF9F6"
             NavigationPage.HasNavigationBar="False">

    <Grid RowDefinitions="Auto, *, Auto">

        <!-- ================= 1. TOP APP BAR (SABİT ÜST BAR) ================= -->
        <Border Grid.Row="0" 
                BackgroundColor="#CCFDFCFB" 
                StrokeThickness="0" 
                HeightRequest="64" 
                Padding="20,0">
            <Grid ColumnDefinitions="*, Auto">
                <!-- Logo / Başlık -->
                <Label Grid.Column="0" 
                       Text="Mardin Şehir Rehberi" 
                       FontSize="22" 
                       FontAttributes="Bold" 
                       TextColor="#725B38" 
                       VerticalOptions="Center" />

                <!-- Sağ İkonlar (Arama & Bildirim) -->
                <HorizontalStackLayout Grid.Column="1" Spacing="16" VerticalOptions="Center">
                    <Label Text="&#xe8b6;" 
                           FontFamily="MaterialSymbols" 
                           FontSize="24" 
                           TextColor="#725B38" 
                           VerticalOptions="Center" />
                    <Label Text="&#xe7f4;" 
                           FontFamily="MaterialSymbols" 
                           FontSize="24" 
                           TextColor="#725B38" 
                           VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Grid>
        </Border>

        <!-- ================= 2. ANA İÇERİK (SCROLLABLE AREA) ================= -->
        <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Spacing="32" Padding="20,16,20,32" MaximumWidthRequest="900" HorizontalOptions="Center">

                <!-- HERO & CAROUSEL HEADER -->
                <VerticalStackLayout Spacing="16">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="HOŞGELDİN" 
                               FontSize="12" 
                               FontAttributes="Bold" 
                               TextColor="#725B38" 
                               CharacterSpacing="2" />
                        <Label Text="Merhaba, Gezgin" 
                               FontSize="32" 
                               FontAttributes="Bold" 
                               TextColor="#1B1C1A" />
                        <Label Text="Mezopotamya'nın altın şehri keşfinizi bekliyor.
" 
                               FontSize="15" 
                               TextColor="#4D463C" />
                    </VerticalStackLayout>

                    <!-- SEARCH BAR -->
                    <Border BackgroundColor="#F5F3F0" 
                            StrokeThickness="0" 
                            HeightRequest="56" 
                            Margin="0,8,0,0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="28" />
                        </Border.StrokeShape>
                        <Grid ColumnDefinitions="48, *, 48">
                            <Label Grid.Column="0" 
                                   Text="&#xe2db;" 
                                   FontFamily="MaterialSymbols" 
                                   FontSize="22" 
                                   TextColor="#7F766A" 
                                   HorizontalOptions="Center" 
                                   VerticalOptions="Center" />

                            <Entry Grid.Column="1"
                                   Placeholder="Tarihi yerleri, çarşıları arayın..." 
                                   PlaceholderColor="#7F766A" 
                                   TextColor="#1B1C1A" 
                                   FontSize="14" 
                                   VerticalOptions="Center" />

                            <Button Grid.Column="2" 
                                    Text="&#xe429;" 
                                    FontFamily="MaterialSymbols" 
                                    FontSize="20" 
                                    TextColor="White" 
                                    BackgroundColor="#008080" 
                                    CornerRadius="20" 
                                    WidthRequest="40" 
                                    HeightRequest="40" 
                                    Padding="0" 
                                    HorizontalOptions="Center" 
                                    VerticalOptions="Center" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <!-- FEATURED CAROUSEL SECTION -->
                <VerticalStackLayout Spacing="16">
                    <Grid ColumnDefinitions="*, Auto">
                        <Label Grid.Column="0" Text="Öne Çıkanlar" FontSize="22" FontAttributes="Bold" TextColor="#1B1C1A" VerticalOptions="End" />
                        <Label Grid.Column="1" Text="Tümünü Gör" FontSize="14" FontAttributes="Bold" TextColor="#008080" VerticalOptions="End" />
                    </Grid>

                    <!-- CollectionView Tek Başına Yeterlidir -->
                    <CollectionView x:Name="HighlightListCollection" HeightRequest="410" HorizontalScrollBarVisibility="Never">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Horizontal" ItemSpacing="16" />
                        </CollectionView.ItemsLayout>

                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <VerticalStackLayout Spacing="8" WidthRequest="260">
                                    <Grid HeightRequest="300">
                                        <Border StrokeThickness="0">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="16" />
                                            </Border.StrokeShape>
                                            <Image Source="{Binding ImageUrl}" Aspect="AspectFill" />
                                        </Border>

                                        <!-- Tag -->
                                        <Border BackgroundColor="#33FFFFFF" 
                                Stroke="#33FFFFFF" 
                                StrokeThickness="1" 
                                HorizontalOptions="End" 
                                VerticalOptions="Start" 
                                Margin="12" 
                                Padding="10,4">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="12" />
                                            </Border.StrokeShape>
                                            <Label Text="{Binding BadgeLabel}" FontSize="11" FontAttributes="Bold" TextColor="White" />
                                        </Border>
                                    </Grid>

                                    <Label Text="{Binding Title}" FontSize="18" FontAttributes="Bold" TextColor="#1B1C1A" MaxLines="1" LineBreakMode="TailTruncation" />

                                    <HorizontalStackLayout Spacing="4">
                                        <Label Text="&#xe56f;" FontFamily="MaterialSymbols" FontSize="16" TextColor="#C5A880" VerticalOptions="Center" />
                                        <Label Text="{Binding Subtitle}" FontSize="14" TextColor="#4D463C" VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

                <!-- BENTO GRID: EXPLORE BY SOUL -->
                <VerticalStackLayout Spacing="16">
                    <Label Text="Ruhunla Keşfet" FontSize="22" FontAttributes="Bold" TextColor="#1B1C1A" />

                    <FlexLayout BindableLayout.ItemsSource="{Binding ResultHomeNawTileDtos}"
                Wrap="Wrap"
                Direction="Row"
                JustifyContent="SpaceBetween"
                AlignItems="Stretch">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Border FlexLayout.Basis="48%"
                        BackgroundColor="#EFEEEB"
                        StrokeThickness="0"
                        HeightRequest="120"
                        Margin="0,0,0,12"
                        Padding="16">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="16" />
                                    </Border.StrokeShape>
                                    <Grid RowDefinitions="Auto, *">
                                        <Label Grid.Row="0"
                               Text="{Binding IconKey}"
                               FontFamily="MaterialSymbols"
                               FontSize="32"
                               TextColor="#725B38" />
                                        <Label Grid.Row="1"
                               Text="{Binding Title}"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="#1B1C1A"
                               VerticalOptions="End" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>

                    <!-- Curated Itineraries (Full Width Banner) //eklendiğinde routes sayfasına yönlendirme yapılacak -->
                    <Border BackgroundColor="#1A008080" Stroke="#33008080" StrokeThickness="1" Padding="16">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16" />
                        </Border.StrokeShape>
                        <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <Label Text="Özenle Hazırlanmış Seyahat Programları" FontSize="16" FontAttributes="Bold" TextColor="#008080" />
                                <Label Text="Yerel halk tarafından özenle seçilmiş rotalar" FontSize="12" TextColor="#4D463C" />
                            </VerticalStackLayout>
                            <Label Grid.Column="1" Text="&#xe55b;" FontFamily="MaterialSymbols" FontSize="28" TextColor="#008080" VerticalOptions="Center" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <!-- POPULAR NOW SECTION -->
                <VerticalStackLayout Spacing="16">
                    <Grid ColumnDefinitions="*, Auto">
                        <Label Grid.Column="0" Text="Popüler" FontSize="22" FontAttributes="Bold" TextColor="#1B1C1A" VerticalOptions="End" />
                        <Label Grid.Column="1" Text="Tümünü Gör" FontSize="14" FontAttributes="Bold" TextColor="#008080" VerticalOptions="End" />
                    </Grid>

                    <VerticalStackLayout Spacing="16">

                        <CollectionView x:Name="PlaceListCollection">

                            <CollectionView.ItemTemplate>

                                <DataTemplate>

                                    <!-- Entry 1 -->
                                    <Grid ColumnDefinitions="80, *, Auto" ColumnSpacing="16" VerticalOptions="Center">
                                        <Border Grid.Column="0" HeightRequest="80" WidthRequest="80" StrokeThickness="0">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnPlaceTapped" />
                                            </Border.GestureRecognizers>
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="12" />
                                            </Border.StrokeShape>
                                            <Image Source="{Binding CoverImageUrl}" Aspect="AspectFill" />
                                        </Border>

                                        <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                            <VerticalStackLayout.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnPlaceTapped" />
                                            </VerticalStackLayout.GestureRecognizers>
                                            <HorizontalStackLayout Spacing="4">
                                                <Label Text="&#xe838;" FontFamily="MaterialSymbols" FontSize="14" TextColor="#D35400" VerticalOptions="Center" />
                                                <Label FontSize="12" FontAttributes="Bold" TextColor="#1B1C1A" VerticalOptions="Center">
                                                    <Label.Text>
                                                        <MultiBinding StringFormat="{}{0} ({1} İnceleme)">
                                                            <Binding Path="Rating" />
                                                            <Binding Path="ReviewCount" />
                                                        </MultiBinding>
                                                    </Label.Text>
                                                </Label>
                                            </HorizontalStackLayout>
                                            <Label Text="{Binding Name}" FontSize="16" FontAttributes="Bold" TextColor="#1B1C1A" />
                                            <Label Text="{Binding TypeLabel}" FontSize="12" TextColor="#4D463C" />
                                        </VerticalStackLayout>

                                        <Label Grid.Column="2" Text="&#xe87e;" FontFamily="MaterialSymbols" FontSize="22" TextColor="#7F766A" VerticalOptions="Center" />
                                    </Grid>

                                </DataTemplate>
                                
                            </CollectionView.ItemTemplate>
                            
                        </CollectionView>
                                               
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <!-- RECOMMENDED BANNER -->
                <Border BackgroundColor="#33C5A880" StrokeThickness="0" Padding="24" Margin="0,8,0,0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="24" />
                    </Border.StrokeShape>
                    <Grid ColumnDefinitions="*, Auto">
                        <VerticalStackLayout Grid.Column="0" Spacing="10" VerticalOptions="Center">
                            <Border BackgroundColor="#725B38" StrokeThickness="0" HorizontalOptions="Start" Padding="8,2">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10" />
                                </Border.StrokeShape>
                                <Label Text="{Binding ResultGetRandomEditorialHighlightDto.BadgeLabel}" FontSize="10" FontAttributes="Bold" TextColor="White" CharacterSpacing="1" />
                            </Border>

                            <Label Text="{Binding ResultGetRandomEditorialHighlightDto.Title}" FontSize="18" FontAttributes="Bold" TextColor="#584323" />
                            <Label Text="{Binding ResultGetRandomEditorialHighlightDto.Description}" FontSize="13" TextColor="#584323" Opacity="0.9" />
                            <Button Text="Explore Details &#xe5c8;" 
                                    FontFamily="MaterialSymbols" 
                                    BackgroundColor="#725B38" 
                                    TextColor="White" 
                                    FontSize="13" 
                                    FontAttributes="Bold" 
                                    CornerRadius="20" 
                                    HeightRequest="42" 
                                    Padding="20,0" 
                                    HorizontalOptions="Start" 
                                    Margin="0,8,0,0" />
                        </VerticalStackLayout>

                        <!-- Decorative Icon -->
                        <Label Grid.Column="1" 
                               Text="&#xea40;" 
                               FontFamily="MaterialSymbols" 
                               FontSize="140" 
                               TextColor="#725B38" 
                               Opacity="0.15" 
                               HorizontalOptions="End" 
                               VerticalOptions="End" 
                               Margin="0,0,-20,-20" />
                    </Grid>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <!-- ================= 3. BOTTOM NAVIGATION BAR (ALT BAR) ================= -->
        <Border Grid.Row="2" 
                BackgroundColor="#E6FDFCFB" 
                StrokeThickness="0" 
                HeightRequest="70" 
                Padding="8,4">
            <Border.Shadow>
                <Shadow Brush="#C5A880" Offset="0,-4" Radius="12" Opacity="0.15" />
            </Border.Shadow>
            <Grid ColumnDefinitions="*, *, *, *">

                <!-- Tab 1: Home (Active) -->
                <VerticalStackLayout Grid.Column="0" HorizontalOptions="Center" VerticalOptions="Center" Spacing="2">
                    <Border BackgroundColor="#4DFF8E58" StrokeThickness="0" Padding="16,4">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16" />
                        </Border.StrokeShape>
                        <Label Text="&#xe88a;" FontFamily="MaterialSymbols" FontSize="22" TextColor="#725B38" />
                    </Border>
                    <Label Text="Home" FontSize="11" FontAttributes="Bold" TextColor="#725B38" HorizontalOptions="Center" />
                </VerticalStackLayout>

                <!-- Tab 2: Discover -->
                <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center" VerticalOptions="Center" Spacing="2">
                    <Label Text="&#xe87a;" FontFamily="MaterialSymbols" FontSize="22" TextColor="#4D463C" HorizontalOptions="Center" />
                    <Label Text="Discover" FontSize="11" TextColor="#4D463C" HorizontalOptions="Center" />
                </VerticalStackLayout>

                <!-- Tab 3: Favorites -->
                <VerticalStackLayout Grid.Column="2" HorizontalOptions="Center" VerticalOptions="Center" Spacing="2">
                    <Label Text="&#xe87e;" FontFamily="MaterialSymbols" FontSize="22" TextColor="#4D463C" HorizontalOptions="Center" />
                    <Label Text="Favorites" FontSize="11" TextColor="#4D463C" HorizontalOptions="Center" />
                </VerticalStackLayout>

                <!-- Tab 4: Profile -->
                <VerticalStackLayout Grid.Column="3" HorizontalOptions="Center" VerticalOptions="Center" Spacing="2">
                    <Label Text="&#xe7fd;" FontFamily="MaterialSymbols" FontSize="22" TextColor="#4D463C" HorizontalOptions="Center" />
                    <Label Text="Profile" FontSize="11" TextColor="#4D463C" HorizontalOptions="Center" />
                </VerticalStackLayout>

            </Grid>
        </Border>

    </Grid>

</ContentPage>