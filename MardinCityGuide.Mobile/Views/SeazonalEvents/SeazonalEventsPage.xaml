<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MardinCityGuide.Mobile.Views.SeazonalEvents.SeazonalEventsPage"
             BackgroundColor="#FDFCFB"
             NavigationPage.HasNavigationBar="False"
             Shell.NavBarIsVisible="False"
             ControlTemplate="{StaticResource MainLayoutTemplate}">

    <Grid RowDefinitions="*">

        <!-- 2. MAIN CONTENT (SCROLLABLE) -->
        <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Padding="20,0,20,32" Spacing="24">

                <!-- HERO SECTION: FEATURED EVENT (MARDIN BIENNIAL) -->
                <Border StrokeShape="RoundRectangle 32" StrokeThickness="0" HeightRequest="420" Margin="0,8,0,0">
                    <Border.Shadow>
                        <Shadow Brush="#C5A880" Offset="0,4" Radius="12" Opacity="0.15" />
                    </Border.Shadow>

                    <Grid>
                        <!-- Arka Plan Görseli -->
                        <Image Source="https://lh3.googleusercontent.com/aida-public/AB6AXuC-peqqd__wTKCs3GooAYgmgS34TtCrdXL1SzNvaZOEhb12ZnZcSE5xDFde49G02xUDmtQCqs0uudiX6SsMv1c87ZLgqBXdf0yTDfMPgykaMFtLHNBwIxlFchy6gxPEqtD6lp3NdzXOKZgZ2MXBgmZwbkcvjfO-NoefGWPg1TjS6G-w7d5KYUT6-GyYpTxnmJeciwLaDlYxAUMWrK6229HpLCmgYxjzDjxj8RtwbN_VEoT5PMozmxUqng" Aspect="AspectFill" />

                        <!-- Dark Overlay Gradient -->
                        <BoxView VerticalOptions="End" HeightRequest="250">
                            <BoxView.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="Transparent" Offset="0.0" />
                                    <GradientStop Color="#D9000000" Offset="1.0" />
                                </LinearGradientBrush>
                            </BoxView.Background>
                        </BoxView>

                        <!-- Hero İçerik -->
                        <VerticalStackLayout VerticalOptions="End" Padding="24" Spacing="8">
                            <Border HorizontalOptions="Start" BackgroundColor="#C5A880" StrokeShape="RoundRectangle 12" StrokeThickness="0" Padding="10,4">
                                <Label Text="ÖNE ÇIKANLAR" FontFamily="BeVietnamProBold" FontSize="11" TextColor="#FFFFFF" CharacterSpacing="1.5" />
                            </Border>

                            <Label Text="Mardin Biennial" FontFamily="ManropeBold" FontSize="26" TextColor="#FFFFFF" />

                            <Label Text="Eski şehrin kalbinde, çağdaş sanatla dolu kültürlerarası bir yolculuk." FontFamily="BeVietnamProRegular" FontSize="14" TextColor="#E0E0E0" Margin="0,0,0,8" />

                            <Button Text="Programları Keşfet" FontFamily="BeVietnamProMedium" FontSize="14" TextColor="#725B38" BackgroundColor="#FDFCFB" CornerRadius="24" HeightRequest="46" HorizontalOptions="Start" Padding="24,0" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- SKY GAZING SECTION (BENTO GRID) -->
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*,Auto" VerticalOptions="End" >
                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label Text="Gökyüzü Seyredin" FontFamily="ManropeSemiBold" FontSize="20" TextColor="#725B38" />
                            <Label Text="Hergün, gün batımını izlemek için en iyi zamanlar." FontFamily="BeVietnamProRegular" FontSize="13" TextColor="#4D463C" />
                        </VerticalStackLayout>
                    </Grid>

                    <!-- Bento Grid Kartları -->
                    <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,*" RowSpacing="12" ColumnSpacing="12" x:Name="RandomReligiousSiteList">
                        <!-- Üst Geniş Kart (Golden Hour) -->
                        <Border Grid.Row="0" Grid.ColumnSpan="2" StrokeShape="RoundRectangle 24" StrokeThickness="1" Stroke="#EAE8E5" BackgroundColor="#B3FFFFFF" Padding="20">
                            <Grid ColumnDefinitions="Auto,*,Auto" x:Name="SkyGazingInfoForToday">
                                <HorizontalStackLayout Grid.Column="0" Spacing="12" VerticalOptions="Center">
                                    <Border WidthRequest="48" HeightRequest="48" StrokeShape="RoundRectangle 24" StrokeThickness="0" BackgroundColor="#F3EAD8">
                                        <Label Text="&#xe1c6;" FontSize="24" TextColor="#4D463C" FontFamily="MaterialSymbols" HeightRequest="24" WidthRequest="24" HorizontalOptions="Center" VerticalOptions="CenterAndExpand" />
                                    </Border>
                                    <VerticalStackLayout VerticalOptions="Center" Spacing="2">
                                        <Label Text="Güneşin Batış Saati" FontFamily="BeVietnamProBold" FontSize="11" TextColor="#4D463C" CharacterSpacing="1" />
                                        <Label FontFamily="ManropeBold" FontSize="18" TextColor="#725B38">
                                            <Label.Text>
                                                <MultiBinding StringFormat="{}{0:HH:mm} - {1:HH:mm}">
                                                    <Binding Path="PeakStart"></Binding>
                                                    <Binding Path="PeakEnd"></Binding>
                                                </MultiBinding>
                                            </Label.Text>
                                        </Label>
                                    </VerticalStackLayout>
                                </HorizontalStackLayout>

                                <Border Grid.Column="2" BackgroundColor="#725B38" StrokeShape="RoundRectangle 16" StrokeThickness="0" Padding="12,6" VerticalOptions="Center">
                                    <Label Text="{Binding VisibilityLabel}" FontFamily="BeVietnamProMedium" FontSize="11" TextColor="#FFFFFF" />
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Sol Alt Kart (Zinciriye) -->
                        <Border Grid.Row="1" Grid.Column="0" StrokeShape="RoundRectangle 24" StrokeThickness="1" Stroke="#1A000000" BackgroundColor="#F5F3F0" Padding="16">
                            <VerticalStackLayout Spacing="6">
                                <Label Text="&#xe55e;" FontFamily="MaterialSymbols" FontSize="20" TextColor="#725B38" HeightRequest="22" WidthRequest="22" HorizontalOptions="Start" />
                                <Label Text="{Binding [0].TagLabel}" FontFamily="ManropeBold" FontSize="18" TextColor="#725B38" />
                                <Label Text="{Binding [0].IconKey}" FontFamily="BeVietnamProBold" FontSize="10" TextColor="#4D463C" CharacterSpacing="0.8" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- Sağ Alt Kart (Kasimiye) -->
                        <Border Grid.Row="1" Grid.Column="1"
                                StrokeShape="RoundRectangle 24"
                                StrokeThickness="1"
                                Stroke="#1A000000"
                                BackgroundColor="#F5F3F0"
                                Padding="16">
                            <VerticalStackLayout Spacing="6">
                                <Label Text="&#xe412;" FontFamily="MaterialSymbols" FontSize="20" TextColor="#725B38" HeightRequest="22" WidthRequest="22" HorizontalOptions="Start" />
                                <Label Text="{Binding [1].TagLabel}" FontFamily="ManropeBold" FontSize="18" TextColor="#725B38" />
                                <Label Text="{Binding [1].IconKey}" FontFamily="BeVietnamProBold" FontSize="10" TextColor="#4D463C" CharacterSpacing="0.8" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>
                </VerticalStackLayout>

                <!-- SEASONAL HIGHLIGHTS (HORIZONTAL SCROLL WITH SPACING) daha bitmedi devam edilecek -->
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0"
                               Text="Sezonun Öne Çıkanları"
                               FontFamily="ManropeSemiBold"
                               FontSize="20"
                               TextColor="#725B38" />
                        <!--<Button Grid.Column="1" Text="&#xe429;" FontFamily="MaterialSymbols" FontSize="20" HeightRequest="24" WidthRequest="24" BackgroundColor="Transparent" />-->
                    </Grid>

                    <CollectionView x:Name="Upcoming4EventsWithImage" HorizontalScrollBarVisibility="Never">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Horizontal" ItemSpacing="16" />
                        </CollectionView.ItemsLayout>

                        <CollectionView.ItemTemplate>
                            <DataTemplate>

                                <!-- Highlight Kart 1 -->
                                <VerticalStackLayout WidthRequest="260" Spacing="8">
                                    <Grid HeightRequest="260">
                                        <Border StrokeShape="RoundRectangle 24" StrokeThickness="0">
                                            <Image Source="{Binding CoverImageUrl}" Aspect="AspectFill" />
                                        </Border>

                                        <!-- Tarih Chip -->
                                        <Border HorizontalOptions="End" VerticalOptions="Start" Margin="12" BackgroundColor="#CCFFFFFF" StrokeShape="RoundRectangle 16" StrokeThickness="0" Padding="12,6">
                                            <Label FontFamily="BeVietnamProMedium" FontSize="12" TextColor="#725B38">
                                                <Label.Text>
                                                    <MultiBinding StringFormat="{}{0:MMMM} {1:dd} - {2:dd}">
                                                        <Binding Path="EventDate"></Binding>
                                                        <Binding Path="EventDate"></Binding>
                                                        <Binding Path="EventEndDate"></Binding>
                                                    </MultiBinding>
                                                </Label.Text>
                                            </Label>
                                        </Border>
                                    </Grid>

                                    <Label Text="{Binding Title}" FontFamily="ManropeBold" FontSize="18" TextColor="#725B38" />
                                    <Label Text="{Binding LocationName}" FontFamily="BeVietnamProRegular" FontSize="13" TextColor="#4D463C" />
                                </VerticalStackLayout>

                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>


                </VerticalStackLayout>

                <!-- FULL CALENDAR SECTION -->
                <VerticalStackLayout Spacing="12">
                    <Label Text="Yaklaşan Etkinlikler" FontFamily="ManropeSemiBold" FontSize="20" TextColor="#725B38" />

                    <!-- Takvim Öğeleri Liste Düzeni -->

                    <CollectionView VerticalScrollBarVisibility="Never" x:Name="GetUpcoming4EventsCollection">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Vertical" ItemSpacing="12" />
                        </CollectionView.ItemsLayout>

                        <CollectionView.ItemTemplate>
                            <DataTemplate>

                                <!-- Calendar Item 1 -->
                                <Border StrokeShape="RoundRectangle 16" StrokeThickness="1" Stroke="#1A000000" BackgroundColor="#FFFFFF" Padding="12">
                                    <Border.Shadow>
                                        <Shadow Brush="#C5A880" Offset="0,2" Radius="8" Opacity="0.1" />
                                    </Border.Shadow>

                                    <Grid ColumnDefinitions="60,*,Auto" ColumnSpacing="16">
                                        <Border Grid.Column="0" WidthRequest="60" HeightRequest="70" StrokeShape="RoundRectangle 12" StrokeThickness="0" BackgroundColor="#4DC5A880">
                                            <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="0">
                                                <Label Text="{Binding EventDate, StringFormat='{0:MMM}'}" FontFamily="BeVietnamProBold" FontSize="11" TextColor="#725B38" HorizontalOptions="Center" />
                                                <Label Text="{Binding EventDate, StringFormat='{0:dd}'}" FontFamily="ManropeBold" FontSize="20" TextColor="#725B38" HorizontalOptions="Center" />
                                            </VerticalStackLayout>
                                        </Border>

                                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="4">
                                            <Label Text="{Binding Title}" FontFamily="ManropeBold" FontSize="15" TextColor="#1B1C1A" LineBreakMode="TailTruncation" />
                                            <HorizontalStackLayout Spacing="4">
                                                <Label Text="&#xe0c8;" FontFamily="MaterialSymbols" FontSize="13" HeightRequest="14" WidthRequest="14" VerticalOptions="Center" />
                                                <Label Text="{Binding LocationName}" FontFamily="BeVietnamProRegular" FontSize="12" TextColor="#4D463C" />
                                            </HorizontalStackLayout>
                                        </VerticalStackLayout>

                                        <!--<Label Grid.Column="2" Text="&#xe5cc;" FontFamily="MaterialSymbols" FontSize="20" HeightRequest="20" WidthRequest="20" VerticalOptions="Center" />-->
                                    </Grid>
                                </Border>

                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>

</ContentPage>